  // ---------- db bootstrap ----------
  // La base solo entrega 1.000 documentos por consulta: los vehículos se reparten en 4 grupos («shard») y se leen en paralelo.
  var SHARDS = 4, shardMaps = {}, shardsSeen = {};
  function shardOf(id){ var t = 0; id = String(id||''); for(var i=0;i<id.length;i++) t += id.charCodeAt(i); return t % SHARDS; }
  function mergeShards(){
    var seen = {};
    Object.keys(shardMaps).forEach(function(k){ shardMaps[k].forEach(function(d,id){ if(verOk(d)){ vehicles.set(id, d); seen[id] = true; } }); });
    Array.from(vehicles.keys()).forEach(function(id){ if(!seen[id]) vehicles.delete(id); });
  }
  function snapInto(map, snap, extra){
    snap.docs.forEach(function(d){ map.set(d.id, Object.assign({}, d.data(), extra(d))); });
    var seen = {}; snap.docs.forEach(function(d){ seen[d.id]=true; });
    Array.from(map.keys()).forEach(function(k){ if(!seen[k]) map.delete(k); });
  }
  var renderTimer = null;
  function scheduleRender(){
    if(renderTimer) return;
    renderTimer = setTimeout(function(){ renderTimer = null; renderAll(); if(currentVid) renderDrawerBody(); }, 250);
  }
  async function init(){
    if(!window.claude || !window.claude.use){ setSyncLabel('Vista sin plataforma Claude — solo lectura local'); renderAll(); return; }
    try{
      db = await window.claude.use('db');
    }catch(e){ db = null; }
    if(!db){
      setSyncLabel('Sin conexión a la base de datos');
      renderAll();
      return;
    }
    setSyncLabel('Sincronizado en vivo', true);
    var onErr = function(err){ setSyncLabel('Error de sincronización: '+err.message); };
    for(var sh=0; sh<SHARDS; sh++){ (function(k){
      db.collection('vehicles').where('shard','==',k).limit(1000).onSnapshot(function(snap){
        var m = new Map(); snap.docs.forEach(function(d){ var o = Object.assign({}, d.data(), {vid:d.id}), ec = estadoCoherente(o); if(ec){ o._estFix = {de:o.estado||'', a:ec}; o.estado = ec; } stokFixOne(o); m.set(d.id, o); });
        shardMaps[k] = m; shardsSeen[k] = true; mergeShards();
        if(Object.keys(shardsSeen).length===SHARDS){ seedState.veh = true; maybeSeed(); }
        scheduleRender();
      }, onErr);
    })(sh); }
    db.collection('novedades').orderBy('fecha','desc').limit(500).onSnapshot(function(snap){
      snapInto(novedades, snap, function(d){ return {id:d.id}; });
      seedState.nov = true; maybeSeed();
      scheduleRender();
    }, onErr);
    db.collection('importaciones').orderBy('fecha','desc').limit(10).onSnapshot(function(snap){
      snapInto(importaciones, snap, function(d){ return {id:d.id}; });
      
      renderImpHist(); renderUplHist();
    }, onErr);
    db.collection('sistema').onSnapshot(function(snap){
      seedState.m2 = snap.docs.some(function(d){ return d.id==='carga_inicial_v9'; });
      seedState.mig = snap.docs.some(function(d){ return d.id==='actualizacion_20261015'; });
      seedState.ent = snap.docs.some(function(d){ return d.id==='entregados_fecha_20261015'; }); seedState.sis = true;
      seedState.quit = snap.docs.some(function(d){ return d.id==='quitar_solo_quiter_20261015'; });
      seedState.cq = snap.docs.some(function(d){ return d.id==='carga_quiter_20261016'; });
      seedState.cf = snap.docs.some(function(d){ return d.id==='carga_fisico_20261016'; });
      (function(){ var best = null; snap.docs.forEach(function(d){ if(/^stok_ref/.test(d.id)){ var o = d.data(); if(o && o.rows && (!best || String(o.fecha||'')>String(best.fecha||''))) best = o; } }); if(best) uplStokFromDb(best); })();
      seedState.imp = true; maybeSeed();
    }, onErr);
    db.collection('alistamientos').onSnapshot(function(snap){
      snapInto(alistamientos, snap, function(d){ return {}; }); _aliIdx = null;
      scheduleRender();
    }, onErr);
    db.collection('prestamos').onSnapshot(function(snap){
      snapInto(prestamos, snap, function(d){ return {}; }); _prIdx = null;
      scheduleRender();
    }, onErr);
    db.collection('casos_extra').onSnapshot(function(snap){
      snapInto(casosExtra, snap, function(d){ return {}; });
      if(cxOpen && document.getElementById('cx_wrap')) cxRefresh(cxOpen);
      scheduleRender();
    }, onErr);
    ntSubscribe(onErr);
    db.collection('trabajos').orderBy('fecha','desc').limit(500).onSnapshot(function(snap){
      snapInto(trabajos, snap, function(d){ return {id:d.id}; });
      seedState.job = true; maybeSeed();
      scheduleRender();
    }, onErr);
  }

