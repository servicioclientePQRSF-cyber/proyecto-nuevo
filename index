  function uplHeaderRow(grid){
    for(var i=0;i<Math.min(grid.length,25);i++){
      for(var j=0;j<grid[i].length;j++){ if(UPL_VIN.indexOf(normH(grid[i][j]))>-1) return i; }
    }
    return -1;
  }
  function uplPickSheet(){
    var names = U.wb.SheetNames, pick = '', first = '';
    names.forEach(function(n){
      var g = XLSX.utils.sheet_to_json(U.wb.Sheets[n], {header:1, defval:'', raw:true});
      if(uplHeaderRow(g)<0) return;
      if(!first) first = n;
      if(!pick && U.K.sheetHint && U.K.sheetHint.test(n)) pick = n;
    });
    U.sheet = pick || first || names[0];
    uplLoadSheet(U.sheet);
  }
  function uplLoadSheet(name){
    U.sheet = name; U.map = {}; U.fixed = {}; U.vals = {}; U.res = null; U.err = '';
    U.grid = XLSX.utils.sheet_to_json(U.wb.Sheets[name], {header:1, defval:'', raw:true});
    U.hi = uplHeaderRow(U.grid);
    if(U.hi<0){ U.err = 'No encontré una columna «VIN» (o «Bastidor», «Chasis») en las primeras 25 filas de la hoja «'+name+'». Elige otra hoja o revisa el archivo.'; return; }
    var head = U.grid[U.hi], used = {};
    function find(al){ for(var c=0;c<head.length;c++){ if(!used[c] && al.indexOf(normH(head[c]))>-1){ used[c]=1; return c; } } return -1; }
    var vc = find(UPL_VIN); U.map.vin = vc;
    (U.K.fields||[]).forEach(function(f){
      var c = find(f.al);
      if(c>=0) U.map[f.k] = c; else if(f.e && f.req){ U.map[f.k] = -2; U.fixed[f.k] = ''; } else U.map[f.k] = -1;
    });
    U.info = 'Hoja «'+name+'»: encabezado en la fila '+(U.hi+1)+', '+(U.grid.length-U.hi-1)+' filas de datos.';
    uplCollect(); uplCompute();
  }
  function uplCollect(){
    (U.K.fields||[]).forEach(function(f){
      if(!f.e) return;
      var prev = U.vals[f.k] || {}, next = {};
      if(U.map[f.k]>=0){
        U.grid.slice(U.hi+1).forEach(function(r){
          if(sanitizeVin(r[U.map.vin]).length<6) return;
          var raw = cStr(uplCell(r, f.k)); if(!raw) return;
          var key = normH(raw); if(!next[key]) next[key] = {raw:raw, n:0, to: prev[key] ? prev[key].to : UPL_ENUM[f.e].guess(raw)};
          next[key].n++;
        });
      }
      U.vals[f.k] = next;
    });
  }
  function uplRowVals(r){
    var x = {};
    (U.K.fields||[]).forEach(function(f){
      if(f.e){
        if(U.map[f.k]===-2){ x[f.k] = U.fixed[f.k]||''; return; }
        var raw = cStr(uplCell(r, f.k)); if(!raw){ x[f.k] = ''; return; }
        var it = U.vals[f.k] && U.vals[f.k][normH(raw)]; var to = it ? it.to : '';
        x[f.k] = to==='__raw' ? raw : to;
      } else if(f.t==='date') x[f.k] = uplDate(uplCell(r, f.k));
      else x[f.k] = cStr(uplCell(r, f.k));
