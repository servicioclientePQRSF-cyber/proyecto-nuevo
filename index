  // --- asignación: lógica compartida (formulario y Excel) ---
  function evaluateAssign(v, a){
    var fact = !!a.fact || isFact(v);
    var mat = !!a.mat || isMat(v);
    var orden = String(a.orden || v.orden_pedido || '').trim();
    var ord = !!a.ord || !!orden;
    if(!(fact||mat||ord)) return {error:'Sin soporte: indica Facturado, Matriculado o Con orden de pedido.'};
    if(a.ord && !orden) return {error:'Falta el número de orden de pedido.'};
    if(!String(a.gerente||'').trim()) return {error:'Falta el gerente de marca.'};
    var now = new Date().toISOString();
    var soportes = [];
    var upd = {asignado:true, asig_gerente:String(a.gerente).trim(), asig_por:operatorName||'—', asig_fecha:now,
               asig_cliente:a.cliente||v.asig_cliente||'', asig_fuente:a.fuente||'Formulario', actualizado:now};
    upd.asig_marca = a.marca || v.asig_marca || '';
    if(fact){ soportes.push('Facturado'); if(v.facturado!==true) upd.facturado = true; }
    if(mat){ soportes.push('Matriculado'); if(!isMat(v)) upd.matricula_estado = 'Matriculado'; if(a.placa) upd.placa = a.placa; }
    if(ord){ soportes.push('Con orden de pedido'); if(orden) upd.orden_pedido = orden; }
    upd.asig_soporte = soportes.join(' + ');
    upd.historial = pushHist(v, 'Asignación comercial', upd.asig_gerente+(upd.asig_marca? ' · '+upd.asig_marca:'')+' · '+upd.asig_soporte+' ('+upd.asig_fuente+')');
    return {update:upd};
  }
