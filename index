  function asCardHtml(m, i){
    var b = m.card.build, st = m.card.status;
    if(!b.changes.length && !b.noEnc.length && !b.avisos.length && !b.same) return '';
    var h = '<div class="as-card"><h4>'+(st==='applied'?'Cambios aplicados':st==='undone'?'Cambios deshechos':st==='discarded'?'Plan descartado':'Vista previa — aún no se guardó nada')+'</h4>';
    h += '<div class="as-sum"><span>'+b.changes.filter(function(c){ return !c.nuevo; }).length+' con cambios</span>'+(b.nuevos? '<span>'+b.nuevos+' nuevos</span>':'')+'<span>'+b.same+' ya estaban así</span>'+(b.noEnc.length? '<span style="color:var(--case-cotizada);">'+b.noEnc.length+' VIN no están en el inventario</span>':'')+'</div>';
    if(b.lineas.length) h += '<ul class="as-lines">'+b.lineas.map(function(l){ return '<li>'+esc(l)+'</li>'; }).join('')+'</ul>';
    b.avisos.forEach(function(a){ h += '<div class="as-warn">⚠ '+esc(a)+'</div>'; });
    if(b.noEnc.length) h += '<div class="as-warn">No encontrados (no se tocan): '+esc(b.noEnc.slice(0,10).join(', '))+(b.noEnc.length>10? ' y '+(b.noEnc.length-10)+' más':'')+'</div>';
    if(b.changes.length){
      h += '<div class="as-tbl"><table><thead><tr><th>VIN</th><th>Vehículo</th><th>Cambios</th></tr></thead><tbody>'+
        b.changes.slice(0,40).map(function(c){ return '<tr><td class="mono">'+esc(c.vin)+'</td><td>'+esc(c.ref||'')+'</td><td>'+c.cambios.map(esc).join('<br>')+'</td></tr>'; }).join('')+'</tbody></table></div>';
      if(b.changes.length>40) h += '<div class="hint" style="margin:0;">Se muestran 40 de '+b.changes.length+'.</div>';
    }
    if(st==='pending' && b.changes.length){
      h += '<div class="as-btns"><button type="button" class="btn primary" data-as-apply="'+i+'">Aplicar '+b.changes.length+' cambio'+(b.changes.length===1?'':'s')+'</button><button type="button" class="btn" data-as-discard="'+i+'">Descartar</button></div>';
    } else if(st==='applied' && AS.undo && AS.undo.msg===m){
      h += '<div class="as-btns"><button type="button" class="btn" data-as-undo="'+i+'">Deshacer</button><span class="hint" style="margin:0;">Se guardó en el historial de cada vehículo.</span></div>';
    }
    return h+'</div>';
