  function asErrCopy(e){
    var c = e && e.code;
    if(c==='not_granted') return 'Para usar el asistente tienes que permitir que la página use Claude con tu cuenta. Vuelve a abrir la página y acepta el permiso.';
    if(c==='rate_limited') return 'Hay muchas consultas seguidas. Espera un momento y vuelve a enviar.';
    if(c==='tools_unavailable') return 'Esta vista no permite que el asistente consulte el inventario. Vuelve a abrir la página.';
    if(c==='invalid_json') return 'No pude armar una respuesta clara. Intenta decirlo de otra forma, o con menos datos a la vez.';
    if(c==='input_too_large' || c==='too_large') return 'El archivo es muy grande para revisarlo de una vez. Adjunta menos columnas u hojas.';
    return 'No pude consultar al asistente ahora. Intenta de nuevo en un momento.';
  }
  async function asSend(text){
    text = String(text||'').trim();
    if(AS.busy) return;
    if(!text && !AS.files.length) return;
    if(!text) text = 'Revisa el archivo adjunto y dime qué cambios propones para el inventario.';
    if(!(perm && perm.editInventario)){ toast('Tu perfil no puede actualizar el inventario.'); return; }
    if(!AS.sample){ AS.msgs.push({r:'e', t:'El asistente no está disponible en esta vista.'}); asRender(); return; }
    AS.msgs.push({r:'u', t:text}); asInputEl.value = ''; asInputEl.style.height = '';
    AS.busy = true; AS.ctl = new AbortController(); asRender();
    var t0 = Date.now(), tick = setInterval(function(){ var el = document.getElementById('asThink'); if(el) el.textContent = 'Pensando… '+Math.round((Date.now()-t0)/1000)+' s'; }, 1000);
    try{
      var out = await AS.sample.json(asTurns(text), {cache:false, signal:AS.ctl.signal, modelTier:'default', tools:asTools()});
      if(!out || typeof out!=='object') out = {respuesta:String(out||''), plan:null};
      var msg = {r:'a', t:String(out.respuesta||'').slice(0,9000)};
      if(out.plan && typeof out.plan==='object'){
        try{
          var build = asBuild(out.plan);
          msg.plan = {resumen:build.resumen};
          msg.card = {build:build, status:'pending'};
          if(!build.changes.length && !msg.t) msg.t = 'No encontré cambios para aplicar con ese pedido.';
          else if(!build.changes.length) msg.t += '\n(No hay cambios por aplicar: todo ya está así o los VIN no están en el inventario.)';
        }catch(e){ msg.t += '\n(No pude preparar la vista previa de los cambios: '+(e && e.message || 'error')+'.)'; }
      }
      if(!msg.t && !msg.card) msg.t = 'No entendí bien. ¿Me lo dices de otra forma?';
      AS.msgs.push(msg);
    }catch(e){
      if(e && e.code==='cancelled'){ AS.msgs.push({r:'n', t:'Detenido.'}); }
      else AS.msgs.push({r:'e', t:asErrCopy(e)});
    }finally{ clearInterval(tick); AS.busy = false; AS.ctl = null; asRender(); }
  }
  async function asAddFiles(list){
    var arr = Array.prototype.slice.call(list||[]);
    for(var i=0;i<arr.length;i++){
      var f = arr[i];
      if(!/\.(xlsx|xls|csv)$/i.test(f.name)){ toast('«'+f.name+'» no es Excel ni CSV.'); continue; }
      if(f.size>15*1024*1024){ toast('«'+f.name+'» pesa más de 15 MB.'); continue; }
      if(AS.files.length>=4){ toast('Máximo 4 archivos a la vez.'); break; }
      if(AS.files.some(function(x){ return x.name===f.name; })){ toast('«'+f.name+'» ya está adjunto.'); continue; }
      try{
        var buf = await f.arrayBuffer();
        var wb = XLSX.read(buf, {type:'array', cellDates:true});
        var dg = asDigest(f.name, wb);
        if(!dg.hojas.length){ toast('No encontré una tabla en «'+f.name+'».'); continue; }
        AS.files.push({name:f.name, wb:wb, digest:dg});
        AS.msgs.push({r:'n', t:'Adjunté «'+f.name+'»: '+dg.hojas.map(function(h){ return h.hoja+' ('+h.filas+' filas)'; }).join(', ')});
      }catch(e){ toast('No pude leer «'+f.name+'».'); }
    }
    asRender();
  }
  async function asApply(i){
    var m = AS.msgs[i]; if(!m || !m.card || m.card.status!=='pending' || AS.busy) return;
    if(!(perm && perm.editInventario)){ toast('Tu perfil no puede actualizar el inventario.'); return; }
    if(!db){ toast('Sin conexión a la base de datos.'); return; }
    var b = m.card.build, btn = asMsgsEl.querySelector('button[data-as-apply="'+i+'"]');
    if(btn){ btn.disabled = true; btn.textContent = 'Guardando…'; }
    AS.busy = true;
    var now = new Date().toISOString(), snaps = [], done = 0, resumen = (b.resumen||'Cambios del asistente').slice(0,120);
    var r = await runPool(b.changes, async function(c){
      var v = c.nuevo ? null : (vehicles.get(c.vid) || findByVin(c.vin));
      if(!c.nuevo && !v) throw new Error('no existe');
      var upd = Object.assign({}, c.upd, {actualizado:now});
      upd.historial = pushHist(v || {}, c.nuevo ? 'Ingreso por asistente' : 'Actualización por asistente', c.cambios.filter(function(x){ return x!=='Vehículo nuevo'; }).join(' · ')+' ('+resumen+')');
      if(c.nuevo){
        var d = Object.assign(blankVeh(c.vin), {en_stock_quiter:false, alertas:[]}, upd, {responsable:operatorName||'', fecha_recibimiento:'', fotos_recepcion:[], checklist:{}, fotos:[], creado:now});
        d.shard = shardOf(c.vin);
        await db.collection('vehicles').doc(c.vin).set(d);
        snaps.push({id:c.vin, created:true});
      } else {
        var before = {};
        Object.keys(upd).forEach(function(k){
          var o = v[k];
          before[k] = (o===undefined) ? (typeof upd[k]==='boolean' ? false : (k==='historial' ? [] : '')) : JSON.parse(JSON.stringify(o));
        });
        await (await docRef(v.vid)).update(upd);
        snaps.push({id:v.vid, before:before});
      }
      done++;
    }, 8);
    try{
      await db.collection('importaciones').add({fecha:now, usuario:operatorName||'—', rol:ROLE_CREDENTIALS[currentRole].label, archivo:'Asistente: '+resumen, modo:'asistente', filas:b.changes.length, actualizados:b.changes.filter(function(c){ return !c.nuevo; }).length, nuevos:b.nuevos, sin_cambios:b.same, ausentes:b.noEnc.length, errores:0, fallos:r.fail});
    }catch(e){}
    AS.busy = false;
    m.card.status = 'applied'; AS.undo = {msg:m, snaps:snaps};
    var nota = r.ok+' vehículo'+(r.ok===1?'':'s')+' guardado'+(r.ok===1?'':'s')+(r.fail? ' · '+r.fail+' no se pudieron guardar':'');
    AS.msgs.push({r:'n', t:'Se aplicó el plan: '+nota+'.'});
    toast(nota); asRender();
  }
  async function asUndo(i){
    var m = AS.msgs[i]; if(!m || !AS.undo || AS.undo.msg!==m || AS.busy) return;
    if(!(perm && perm.editInventario)){ toast('Tu perfil no puede actualizar el inventario.'); return; }
    var btn = asMsgsEl.querySelector('button[data-as-undo="'+i+'"]'); if(btn){ btn.disabled = true; btn.textContent = 'Deshaciendo…'; }
    AS.busy = true;
    var snaps = AS.undo.snaps;
    var r = await runPool(snaps, async function(s){
      if(s.created) await (await docRef(s.id)).delete();
      else await (await docRef(s.id)).update(s.before);
    }, 8);
    AS.busy = false; m.card.status = 'undone'; AS.undo = null;
    AS.msgs.push({r:'n', t:'Se deshicieron los cambios: '+r.ok+' vehículo'+(r.ok===1?'':'s')+(r.fail? ' ('+r.fail+' con error)':'')+'.'});
    toast('Cambios deshechos'); asRender();
  }

  // ---- historial de conversaciones del asistente (se guarda solo; se borra únicamente si tú lo decides) ----
  var ASH = {list:[], curId:null, lastSig:'', timer:null, unsub:null, role:null, first:true};
  function asSer(){
    return AS.msgs.filter(function(m){ return m.r==='u' || m.r==='a' || m.r==='n'; }).slice(-80).map(function(m){
      var t = String(m.t||'');
      if(m.card){ var st = m.card.status; t += '\n[Plan: '+((m.card.build && m.card.build.resumen)||'')+' — '+(st==='applied'?'aplicado':st==='undone'?'deshecho':st==='discarded'?'descartado':'sin aplicar')+']'; }
      return {r:m.r, t:t};
    });
  }
  function asTitulo(msgs){ var u = msgs.filter(function(m){ return m.r==='u'; })[0]; var t = u ? u.t.replace(/\s+/g,' ').trim() : 'Conversación'; return t.length>70 ? t.slice(0,67)+'…' : t; }
  function asSchedSave(){ if(ASH.timer) clearTimeout(ASH.timer); ASH.timer = setTimeout(asSave, 700); }
  async function asSave(){
    ASH.timer = null;
    if(!db || !perm || !perm.editInventario || AS.busy) return;
    var msgs = asSer(); if(!msgs.some(function(m){ return m.r==='u'; })) return;
    var sig = JSON.stringify(msgs); if(sig===ASH.lastSig) return;
    var now = new Date().toISOString(), isNew = !ASH.curId;
    if(isNew) ASH.curId = 'c'+Date.now().toString(36)+Math.random().toString(36).slice(2,6);
    var id = ASH.curId, d = {rol:currentRole, titulo:asTitulo(msgs), actualizado:now, n:msgs.length, msgs:msgs};
    var prev = ASH.list.filter(function(x){ return x.id===id; })[0];
    d.creado = prev && prev.creado ? prev.creado : now;
    ASH.lastSig = sig;
    try{ await db.collection('asistente_chats').doc(id).set(d); }
    catch(e){ ASH.lastSig = ''; if(isNew) ASH.curId = null; return; }
    var o = Object.assign({id:id}, d), i = -1; ASH.list.forEach(function(x,k){ if(x.id===id) i = k; });
    if(i<0) ASH.list.unshift(o); else ASH.list[i] = o;
    asHistRender();
  }
  function asHistSubscribe(){
    if(!db || !perm || !perm.editInventario) return;
    if(ASH.unsub && ASH.role===currentRole) return;
    if(ASH.unsub){ try{ ASH.unsub(); }catch(e){} }
    ASH.role = currentRole; ASH.first = true;
    try{
      ASH.unsub = db.collection('asistente_chats').where('rol','==',currentRole).onSnapshot(function(snap){
        var l = []; snap.forEach(function(doc){ var d = doc.data(); if(d) l.push(Object.assign({id:doc.id}, d)); });
        l.sort(function(a,b){ return String(b.actualizado||'').localeCompare(String(a.actualizado||'')); });
        ASH.list = l;
        if(ASH.first){
          ASH.first = false;
          if(!AS.msgs.some(function(m){ return m.r==='u'; }) && l[0] && !AS.busy){ asOpenChat(l[0].id, true); }
        }
        asHistRender();
      }, function(){});
    }catch(e){}
  }
  function asOpenChat(id, quiet){
    var c = ASH.list.filter(function(x){ return x.id===id; })[0]; if(!c || AS.busy) return;
    AS.msgs = (c.msgs||[]).map(function(m){ return {r:m.r, t:m.t}; }); AS.undo = null; AS.files = [];
    ASH.curId = id; ASH.lastSig = JSON.stringify(asSer());
    if(!quiet){ document.getElementById('asHistBox').style.display = 'none'; }
    asRender();
  }
  function asFechaH(iso){ try{ var d = new Date(iso); return d.toLocaleDateString('es-CO',{day:'2-digit',month:'short'})+' '+d.toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit'}); }catch(e){ return ''; } }
  function asHistRender(){
    var box = document.getElementById('asHistBox'); if(!box || box.style.display==='none') return;
    if(!ASH.list.length){ box.innerHTML = '<div class="hint" style="margin:6px 8px;">Aún no hay conversaciones guardadas. Se guardan solas y solo se borran cuando tú las eliminas.</div>'; return; }
