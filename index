      if((rec.alertas||[]).join('|')!==(v.alertas||[]).join('|')) upd.alertas = rec.alertas;
      var entry = {vin:vin, vid:v.vid, ref:v.referencia||rec.referencia||'', upd:upd, cambios:cambios};
      if(Object.keys(upd).length){ if(!cambios.length) entry.cambios = ['Datos complementarios (fechas, stock, transporte, alertas)']; res.cambios.push(entry); }
      else res.iguales.push(entry);
    });
    vehiclesArr().forEach(function(v){ if(!seen[v.vid] && !esSalida(v)) res.ausentes.push({vin:v.vin||'', vid:v.vid, ref:v.referencia||'', estado:v.estado, placa:v.placa||''}); });
    return res;
  }
  function cruSummaryHtml(built){
