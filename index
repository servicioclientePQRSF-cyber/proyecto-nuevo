  document.getElementById('up_file').addEventListener('change', async function(e){
    var file = e.target.files && e.target.files[0]; if(!file) return;
    if(!(perm && perm.assign)){ toast('Solo el Jefe de Operaciones o el Coordinador PDI pueden cargar asignaciones.'); return; }
    if(!window.XLSX){ toast('No se pudo cargar el lector de Excel. Revisa la conexión e inténtalo de nuevo.'); return; }
