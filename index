  async function runPool(items, worker, size){
    var i = 0, ok = 0, fail = 0;
    async function lane(){ while(i<items.length){ var it = items[i++]; try{ await worker(it); ok++; }catch(e){ fail++; } } }
    var lanes = []; for(var k=0;k<size;k++) lanes.push(lane());
    await Promise.all(lanes);
    return {ok:ok, fail:fail};
  }
  document.getElementById('imp_apply').addEventListener('click', async function(){
    if(!(perm && perm.importInv)){ toast('Tu perfil no puede importar inventario.'); return; }
    if(!db){ toast('Sin conexión a la base de datos.'); return; }
    var res = imp.result; if(!res) return;
    var btn = this, msg = document.getElementById('imp_msg'); btn.disabled = true;
    var now = new Date().toISOString(); var fname = imp.fileName||'archivo';
    var total = res.cambios.length + res.nuevos.length, done = 0;
    function prog(){ msg.textContent = 'Guardando '+done+' de '+total+'…'; }
    prog();
    var r1 = await runPool(res.cambios, async function(c){
      var v = vehicles.get(c.vid) || {};
      var upd = Object.assign({}, c.upd, {actualizado:now, historial:pushHist(v,'Actualización por archivo', c.cambios.join(' · ')+' ('+fname+')')});
      await db.collection('vehicles').doc(c.vid).update(upd); done++; if(done%10===0) prog();
    }, 8);
    var r2 = await runPool(res.nuevos, async function(n){
      var d = Object.assign({}, n.data, {responsable:operatorName||'', fecha_recibimiento:'', fotos_recepcion:[], checklist:{},
        historial:[{fecha:now, evento:'Ingreso por archivo', usuario:operatorName||'—', detalle:'Creado desde '+fname}], creado:now, actualizado:now});
      d.shard = shardOf(n.vin);
      await db.collection('vehicles').doc(n.vin).set(d); done++; if(done%10===0) prog();
    }, 8);
    var nNov = 0;
