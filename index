<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>

<title>PDI Motor K</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Manrope:wght@600;700;800&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
  :root{
    --bg:#dde0e4;
    --surface:#ffffff;
    --surface-2:#e8ebe6;
    --border:#d3d8cf;
    --text:#15170f;
    --text-dim:#5c6456;
    --accent:#2e7d3a;
    --accent-strong:#1f5c29;
    --accent-soft:#e1efe0;
    --ink:#111310;
    --state-transito:#c9822a;
    --state-otro:#7c5cbf;
    --state-bodega:#4f6a8f;
    --state-cliente:#3e7cb1;
    --state-entregado:#6b7280;
    --state-fuera:#a3a8a5;
    --state-vitrina:#2e7d3a;
    --state-porT:#a8741a;
    --state-liberar:#b4533c;
    --state-taller:#8a3b7a;
    --state-sinubic:#7a8279;
    --case-abierta:#c0392b;
    --case-cotizada:#c9822a;
    --case-aprobada:#3e7cb1;
    --case-resuelta:#2e8b74;
    --shadow: 0 8px 24px -12px rgba(15,30,20,.28);
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]):not([data-theme="white"]){
      --bg:#050605;
      --surface:#161b17;
      --surface-2:#1d231e;
      --border:#2c342c;
      --text:#edf1ea;
      --text-dim:#98a494;
      --accent:#4caf52;
      --accent-strong:#8fd68f;
      --accent-soft:#1b2c1b;
      --state-transito:#d99b4a;
      --state-otro:#a084d6;
      --state-bodega:#8ba2c2;
      --state-cliente:#6ba3d6;
      --state-entregado:#9aa7a4;
      --state-fuera:#6d7471;
      --state-vitrina:#4caf52;
      --state-porT:#d4a24a;
      --state-liberar:#e07a5f;
      --state-taller:#c27bb3;
      --state-sinubic:#9aa59a;
      --case-abierta:#e0645a;
      --case-cotizada:#d99b4a;
      --case-aprobada:#6ba3d6;
      --case-resuelta:#4fae8f;
      --shadow: 0 8px 28px -12px rgba(0,0,0,.55);
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"]{
    --bg:#050605; --surface:#161b17; --surface-2:#1d231e; --border:#2c342c;
    --text:#edf1ea; --text-dim:#98a494; --accent:#4caf52; --accent-strong:#8fd68f; --accent-soft:#1b2c1b;
    --state-transito:#d99b4a; --state-otro:#a084d6; --state-bodega:#8ba2c2; --state-cliente:#6ba3d6; --state-entregado:#9aa7a4; --state-fuera:#6d7471;
    --state-vitrina:#4caf52; --state-porT:#d4a24a; --state-liberar:#e07a5f; --state-taller:#c27bb3; --state-sinubic:#9aa59a;
    --case-abierta:#e0645a; --case-cotizada:#d99b4a; --case-aprobada:#6ba3d6; --case-resuelta:#4fae8f;
    --shadow: 0 8px 28px -12px rgba(0,0,0,.55); color-scheme: dark;
  }

  *{box-sizing:border-box;}
  body{background:var(--bg);color:var(--text);font-family:'IBM Plex Sans',system-ui,sans-serif;}
  h1,h2,h3,.display{font-family:'Manrope',system-ui,sans-serif;letter-spacing:-.01em;text-wrap:balance;}
  .mono{font-family:'IBM Plex Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums;}
  a{color:var(--accent);}
  button{font-family:inherit;}

  .app{max-width:1240px;margin:0 auto;padding:0 20px 64px;}

  /* ---- marca Motor K: barra negra, menú blanco con logo al centro, pie negro ---- */
  :root{--brand:#93c01f;--logo-light:url(data:image/png;base64,);--logo-dark:url(data:image/png;base64,);--logo-img:var(--logo-light);}
  @media (prefers-color-scheme: dark){ :root:not([data-theme="light"]):not([data-theme="white"]){--logo-img:var(--logo-dark);} }
  :root[data-theme="dark"]{--logo-img:var(--logo-dark);}
  :root[data-theme="white"]{--bg:#ffffff;--surface-2:#eef0ed;--border:#d3d8cf;--shadow:0 8px 24px -12px rgba(15,30,20,.18);}
  .logo{display:block;aspect-ratio:640/184;background:center/contain no-repeat var(--logo-img);}
  .topbar{background:#000;color:#fff;}
  .topbar-in{max-width:1240px;margin:0 auto;padding:9px 20px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;}
  .tb-title{font:500 12.5px 'Montserrat','IBM Plex Sans',sans-serif;letter-spacing:.02em;text-transform:uppercase;margin-right:auto;}
  .topbar .operator{color:rgba(255,255,255,.82);}
  .topbar .operator button{background:transparent;color:#fff;border-color:rgba(255,255,255,.35);}
  .topbar .operator button:hover{border-color:var(--brand);color:var(--brand);}
  .topbar .role-chip{background:rgba(147,192,31,.2);color:#c9e86b;}
  .topbar .dot{background:#8a8f88;}
  .topbar .dot.live{background:var(--brand);}
  .theme-pick{display:inline-flex;gap:7px;align-items:center;flex:none;}
  .theme-pick button{width:22px;height:22px;border-radius:50%;border:2px solid #8a9088;padding:0;cursor:pointer;}
  .theme-pick button.on{outline:2px solid var(--brand);outline-offset:2px;border-color:var(--brand);}
  .theme-btn{width:34px;height:34px;border-radius:50%;border:none;background:var(--brand);color:#0b0d0b;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;flex:none;}
  .theme-btn:hover{filter:brightness(1.1);}
  .theme-btn:focus-visible,nav.tabs button:focus-visible{outline:2px solid var(--brand);outline-offset:2px;}
  .theme-btn svg{width:18px;height:18px;}
  header.top{position:sticky;top:0;z-index:20;background:var(--surface);border-bottom:1px solid var(--border);padding:6px 0;}
  .top-row{max-width:1240px;margin:0 auto;padding:0 20px;display:flex;align-items:center;justify-content:center;}
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}
  nav.tabs{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:0;background:none;padding:0;margin:0;}
  nav.tabs button{border:none;border-bottom:3px solid transparent;background:transparent;color:var(--text);font:600 12.5px 'Montserrat','IBM Plex Sans',sans-serif;text-transform:uppercase;letter-spacing:.02em;padding:22px 12px 19px;border-radius:0;cursor:pointer;white-space:nowrap;}
  nav.tabs button.active{background:transparent;color:var(--accent-strong);border-bottom-color:var(--brand);box-shadow:none;}
  nav.tabs button:hover:not(.active){color:var(--accent);}
  .nav-logo{width:178px;margin:0 22px;flex:none;}
  .logo-m{display:none;width:170px;margin:4px auto 0;}

  .operator{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-dim);}
  .operator button{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:7px;padding:6px 10px;font:600 12px 'IBM Plex Sans';cursor:pointer;}
  .operator button:hover{border-color:var(--accent);}
  .role-chip{background:var(--accent-soft);color:var(--accent-strong);border-radius:999px;padding:4px 10px;font-weight:700;font-size:11.5px;text-transform:uppercase;letter-spacing:.02em;}
  .dot{width:8px;height:8px;border-radius:50%;background:var(--state-entregado);flex:none;}
  .dot.live{background:var(--case-resuelta);}

  main{padding-top:22px;}
  section.view{display:none;}
  section.view.active{display:block;}

  .stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:22px;}
  .stat{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px 16px;}
  .stat .num{font-family:'Manrope';font-weight:800;font-size:32px;line-height:1;}
  .stat .lbl{font-size:12px;color:var(--text-dim);margin-top:4px;}
  .stat.accentline{border-left:4px solid var(--accent);}

  h2.section-title{font-size:19px;font-weight:800;margin:28px 0 12px;display:flex;align-items:center;gap:10px;}
  h2.section-title .tag{font-size:11px;font-family:'IBM Plex Sans';font-weight:600;color:var(--text-dim);background:var(--surface-2);padding:3px 8px;border-radius:999px;letter-spacing:.03em;text-transform:uppercase;}

  .site-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px;background:
      linear-gradient(var(--surface-2) 1px,transparent 1px) 0 0/100% 24px,
      linear-gradient(90deg,var(--surface-2) 1px,transparent 1px) 0 0/24px 100%;
    background-color:var(--bg);
    border:1px dashed var(--border);border-radius:14px;padding:16px;
  }
  .loc-card{background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:13px 14px;box-shadow:var(--shadow);}
  .loc-card .name{font-weight:700;font-size:13.5px;display:flex;justify-content:space-between;align-items:baseline;gap:8px;}
  .loc-card .name .count{font-family:'Manrope';font-weight:800;font-size:21px;color:var(--accent-strong);}
  .loc-bar{display:flex;height:8px;border-radius:5px;overflow:hidden;margin:9px 0 8px;background:var(--surface-2);}
  .loc-bar span{height:100%;}
  .loc-refs{font-size:11.5px;color:var(--text-dim);display:flex;flex-direction:column;gap:2px;}
  .loc-refs b{color:var(--text);font-weight:600;}
  .loc-empty{font-size:11.5px;color:var(--text-dim);font-style:italic;}

  .pill{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:600;padding:3px 9px;border-radius:999px;white-space:nowrap;}
  .pill .sw{width:7px;height:7px;border-radius:50%;flex:none;}

  .toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px;}
  select,input[type=text],input[type=search],input[type=date],input[type=number],input[type=password],textarea{
    background:var(--surface);border:1px solid var(--border);color:var(--text);border-radius:8px;
    padding:8px 10px;font:500 13px 'IBM Plex Sans';outline:none;
  }
  select:focus,input:focus,textarea:focus,button:focus-visible{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft);}
  textarea{font-family:'IBM Plex Sans';width:100%;resize:vertical;min-height:64px;}
  label.field{display:flex;flex-direction:column;gap:5px;font-size:12px;color:var(--text-dim);font-weight:600;}
  .btn{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:8px;padding:9px 14px;font:600 13px 'IBM Plex Sans';cursor:pointer;}
  .btn:hover{border-color:var(--accent);}
  .btn.primary{background:var(--accent);border-color:var(--accent);color:#fff;}
  .btn.primary:hover{background:var(--accent-strong);border-color:var(--accent-strong);}
  .btn.ghost{border-color:transparent;background:transparent;}
  .btn.small{padding:6px 10px;font-size:12px;}
  .btn:disabled{opacity:.5;cursor:not-allowed;}

  table.inv{width:100%;border-collapse:collapse;font-size:13px;}
  table.inv thead th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--text-dim);padding:0 10px 8px;border-bottom:1px solid var(--border);}
  table.inv tbody td{padding:10px;border-bottom:1px solid var(--border);vertical-align:middle;}
  table.inv tbody tr{cursor:pointer;}
  table.inv tbody tr:hover td{background:var(--surface-2);}
  .table-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:12px;background:var(--surface);}
  .table-wrap table{margin:0;}
  .table-wrap thead th{background:var(--surface);position:sticky;top:0;}
  .empty-state{border:1px dashed var(--border);border-radius:14px;padding:36px 20px;text-align:center;color:var(--text-dim);}
  .empty-state b{color:var(--text);display:block;font-size:15px;margin-bottom:6px;}
  .readonly-note{font-size:11.5px;color:var(--text-dim);background:var(--surface-2);border-radius:8px;padding:7px 10px;margin-bottom:12px;}

  .overlay{position:fixed;inset:0;background:rgba(10,16,10,.45);opacity:0;pointer-events:none;transition:opacity .18s;z-index:40;}
  .overlay.open{opacity:1;pointer-events:auto;}
  .drawer{position:fixed;top:0;right:0;height:100%;width:min(480px,100%);background:var(--surface);border-left:1px solid var(--border);box-shadow:-14px 0 30px -18px rgba(0,0,0,.4);transform:translateX(100%);transition:transform .2s ease;z-index:41;display:flex;flex-direction:column;}
  .drawer.open{transform:translateX(0);}
  .drawer-head{padding:16px 18px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:flex-start;gap:10px;}
  .drawer-body{padding:16px 18px;overflow-y:auto;flex:1;}
  .drawer-close{border:none;background:var(--surface-2);width:30px;height:30px;border-radius:8px;font-size:16px;cursor:pointer;color:var(--text);flex:none;}
  .drawer h3{font-size:20px;margin:0 0 2px;}
  .drawer .sub{color:var(--text-dim);font-size:12.5px;}

  fieldset.block{border:1px solid var(--border);border-radius:11px;padding:12px 14px 14px;margin:0 0 16px;}
  fieldset.block legend{padding:0 6px;font:700 12px 'IBM Plex Sans';color:var(--accent-strong);text-transform:uppercase;letter-spacing:.03em;}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .stack{display:flex;flex-direction:column;gap:10px;}

  .chk-row{display:flex;align-items:center;gap:9px;padding:6px 0;border-bottom:1px solid var(--border);font-size:13.5px;}
  .chk-row:last-child{border-bottom:none;}
  .chk-row input{width:16px;height:16px;accent-color:var(--accent);}

  .hist-item{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);font-size:12.5px;}
  .hist-item:last-child{border-bottom:none;}
  .hist-item .when{color:var(--text-dim);white-space:nowrap;flex:none;width:88px;}
  .hist-item .who{font-weight:600;}

  .nov-card{border:1px solid var(--border);border-radius:11px;padding:12px 13px;background:var(--surface);margin-bottom:10px;}
  .nov-card .top{display:flex;justify-content:space-between;gap:8px;align-items:flex-start;}
  .nov-card p{margin:8px 0;font-size:13px;}
  .nov-photos{display:flex;gap:6px;margin-top:6px;flex-wrap:wrap;}
  .nov-photos img{width:56px;height:56px;object-fit:cover;border-radius:7px;border:1px solid var(--border);}

  .kanban{display:grid;grid-template-columns:repeat(4,minmax(220px,1fr));gap:14px;}
  .kcol{background:var(--surface-2);border-radius:12px;padding:10px;min-height:120px;}
  .kcol h4{font-size:12.5px;text-transform:uppercase;letter-spacing:.03em;display:flex;align-items:center;gap:7px;margin:2px 4px 10px;}
  .kcol h4 .n{margin-left:auto;font-family:'IBM Plex Mono';background:var(--surface);border-radius:999px;padding:1px 8px;font-size:11px;}
  .kcard{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:10px 11px;margin-bottom:9px;cursor:pointer;font-size:12.5px;box-shadow:var(--shadow);}
  .kcard .plate{font-family:'IBM Plex Mono';font-weight:600;font-size:13px;}
  .kcard .desc{color:var(--text-dim);margin-top:5px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
  .kcard .foot{display:flex;justify-content:space-between;margin-top:7px;color:var(--text-dim);font-size:11px;}

  .modal-wrap{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:42;opacity:0;pointer-events:none;transition:opacity .15s;}
  .modal-wrap.open{opacity:1;pointer-events:auto;}

  /* ---- ubicar unidades seleccionadas ---- */
  table.inv .sel-col{width:34px;padding-left:6px;padding-right:2px;}
  table.inv .sel-col input{width:17px;height:17px;cursor:pointer;accent-color:var(--accent);}
  table.inv tbody tr.is-sel td{background:var(--accent-soft);}
  .sel-bar{position:fixed;left:50%;bottom:18px;transform:translate(-50%,140%);z-index:39;display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:center;
    background:var(--ink);color:#fff;border-radius:14px;padding:10px 12px 10px 18px;box-shadow:0 14px 34px -14px rgba(0,0,0,.6);transition:transform .2s ease;max-width:calc(100vw - 32px);}
  .sel-bar.show{transform:translate(-50%,0);}
  .sel-bar .n{font:800 15px 'Manrope',sans-serif;}
  .sel-bar .btn{border-color:rgba(255,255,255,.25);background:transparent;color:#fff;}
  .sel-bar .btn.go{background:var(--brand);border-color:var(--brand);color:#111;font-weight:700;}
  .loc-wrap{background:rgba(10,16,10,.5);}
  .modal.loc-modal{width:min(780px,94vw);max-height:88vh;padding:0;display:flex;flex-direction:column;}
  .loc-head{padding:18px 20px 12px;border-bottom:1px solid var(--border);display:flex;gap:12px;align-items:flex-start;}
  .loc-head h3{margin:0;font-size:20px;}
  .loc-head .sub{color:var(--text-dim);font-size:13px;margin-top:3px;}
  .loc-head .x{margin-left:auto;border:0;background:transparent;font-size:18px;cursor:pointer;color:var(--text-dim);}
  .loc-body{overflow-y:auto;padding:14px 20px 6px;}
  .loc-group{border:1px solid var(--border);border-left:5px solid var(--brand);border-radius:12px;margin-bottom:12px;overflow:hidden;}
  .loc-group.none{border-left-color:var(--state-sinubic);}
  .loc-gh{display:flex;align-items:baseline;gap:10px;padding:10px 14px;background:var(--surface-2);}
  .loc-gh .lbl{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--text-dim);}
  .loc-gh .name{font:800 19px/1.15 'Manrope',sans-serif;color:var(--accent-strong);overflow-wrap:anywhere;}
  .loc-group.none .loc-gh .name{color:var(--text-dim);}
  .loc-gh .cnt{margin-left:auto;font:700 13px 'IBM Plex Mono',monospace;white-space:nowrap;}
  .loc-row{display:grid;grid-template-columns:minmax(150px,max-content) minmax(0,1fr) max-content max-content;gap:4px 12px;align-items:center;padding:9px 14px;border-top:1px solid var(--border);cursor:pointer;font-size:13px;}
  .loc-row:hover{background:var(--surface-2);}
  .loc-row .vin{font-family:'IBM Plex Mono',monospace;font-size:12.5px;overflow-wrap:anywhere;}
  .loc-row .d{color:var(--text-dim);font-size:12px;white-space:nowrap;}
  .loc-foot{display:flex;gap:8px;flex-wrap:wrap;padding:12px 20px;border-top:1px solid var(--border);}
  .loc-foot .btn:last-child{margin-left:auto;}
  .loc-miss{border:1px dashed var(--border);border-radius:10px;padding:10px 14px;margin-bottom:12px;font-size:12.5px;color:var(--text-dim);}
  .loc-miss .mono{color:var(--text);}
  .multi-box{margin-top:18px;}
  .multi-box textarea{width:100%;min-height:96px;border:1px solid var(--border);border-radius:10px;padding:10px 12px;background:var(--surface);color:var(--text);font:13px 'IBM Plex Mono',monospace;resize:vertical;}
  @media (max-width:640px){ .loc-row{grid-template-columns:minmax(0,1fr) max-content;} .loc-row .vin,.loc-row .veh{grid-column:1/-1;} }
  .modal{background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow);width:min(460px,92vw);max-height:86vh;overflow-y:auto;padding:18px 20px;}

  .form-title{font-size:21px;font-weight:800;margin:4px 0 4px;}
  .form-desc{color:var(--text-dim);font-size:13px;margin-bottom:18px;}
  .photo-input{border:1px dashed var(--border);border-radius:10px;padding:12px;text-align:center;font-size:12.5px;color:var(--text-dim);}
  .photo-preview{display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;}
  .photo-preview img{width:60px;height:60px;object-fit:cover;border-radius:8px;border:1px solid var(--border);}
  .helptext{font-size:11.5px;color:var(--text-dim);margin-top:4px;}
  nav.tabs button[data-sub], nav.tabs button[data-grp]{display:none !important;}
  nav.tabs button .caret{display:inline-block;font-size:10px;margin-left:5px;opacity:.7;transition:transform .15s;}
  nav.tabs button[aria-expanded="true"] .caret{transform:rotate(180deg);}
  .nav-menu{position:fixed;z-index:40;min-width:270px;max-width:92vw;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:0 12px 32px rgba(0,0,0,.2);padding:6px;display:flex;flex-direction:column;gap:2px;}
  .nav-menu[hidden]{display:none;}
  .nav-menu button{text-align:left;border:1px solid transparent;background:transparent;color:var(--text);font:600 13px 'IBM Plex Sans',sans-serif;padding:10px 12px;border-radius:8px;cursor:pointer;}
  .nav-menu button:hover,.nav-menu button:focus-visible{background:var(--surface-2);outline:none;}
  .nav-menu button.active{background:var(--accent-soft);color:var(--accent-strong);border-color:var(--accent);}
  .nav-menu button.up{color:var(--accent-strong);}
  .subnav{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 16px;padding:6px;background:var(--surface);border:1px solid var(--border);border-radius:12px;}
