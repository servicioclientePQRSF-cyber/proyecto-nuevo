  }
  function uplCompute(){
    var K = U.K, res = {cambios:[], nuevos:[], iguales:[], omitidos:[], noenc:[], errores:[], fuera:[], repetidos:0};
    U.res = res;
    if(K.special==='stok'){ return; }
    if(U.hi<0 || U.map.vin==null || U.map.vin<0) return;
    var byVin = {}, order = [];
    U.grid.slice(U.hi+1).forEach(function(r, idx){
      if(r.every(function(c){ return String(c).trim()===''; })) return;
      var raw = U.map.vin>=0 ? cStr(r[U.map.vin]) : '', vin = sanitizeVin(raw), line = U.hi+2+idx;
      if(!vin || vin.length<6){ res.errores.push({line:line, vin:raw||'—', msg: raw ? 'VIN demasiado corto ('+vin.length+' caracteres).' : 'Fila sin VIN.'}); return; }
      if(byVin[vin]) res.repetidos++; else order.push(vin);
      byVin[vin] = {r:r, line:line};
    });
    order.forEach(function(vin){
      var it = byVin[vin], x = uplRowVals(it.r), v = findByVin(vin);
