      if(parsed.error){ upRows=[]; renderUploadPreview(); document.getElementById('up_preview').innerHTML='<div class="found-note bad">'+esc(parsed.error)+'</div>'; return; }
      var defG = '';
      var res = parsed.rows.map(function(r){ return evalUploadRow(r, defG); });
      var lastIdx = {};
      res.forEach(function(r,i){ if(r.vin) lastIdx[r.vin]=i; });
      res.forEach(function(r,i){ if(r.vin && lastIdx[r.vin]!==i){ r.skip=true; r.update=null; r.error=null; } });
      upRows = res;
      renderUploadPreview();
      if(!res.length) document.getElementById('up_preview').innerHTML='<div class="found-note bad">El archivo no tiene filas con datos debajo del encabezado.</div>';
    }catch(err){
