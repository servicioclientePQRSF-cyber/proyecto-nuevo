    var uc = F.cols.slice().sort(function(a,b){ return a.j-b.j; });
    var cur = cru.ubicSel>=0 ? cru.ubicSel : (uc.length? uc[uc.length-1].j : -1);
    var prevCol = -1; uc.forEach(function(c){ if(c.j<cur) prevCol = c.j; });
    res.ubicActual = (uc.filter(function(c){ return c.j===cur; })[0]||{}).name || '';
    res.ubicCols = uc;
    res.hojas.push({n:F.sheet, ok:true, filas:gF.length-F.h.hi-1});

