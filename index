  function asTurns(userText){
    var ctx = 'FECHA DE HOY: '+todayISO()+'\n\nRESUMEN DEL INVENTARIO:\n'+JSON.stringify(asResumen())+
      '\n\nVEHÍCULOS MENCIONADOS EN EL MENSAJE (datos actuales):\n'+JSON.stringify(asMencionados(userText))+
      '\n\nARCHIVOS ADJUNTOS:\n'+(AS.files.length ? JSON.stringify(AS.files.map(function(f){ return f.digest; })) : '(ninguno)')+
      '\n\nMENSAJE DEL USUARIO:\n'+userText;
    var raw = [];
    AS.msgs.forEach(function(m){
      if(m.r==='u') raw.push({role:'user', content:m.t});
      else if(m.r==='a') raw.push({role:'assistant', content:m.t+(m.plan? '\n[Plan propuesto: '+(m.plan.resumen||'')+']' : '')});
      else if(m.r==='n') raw.push({role:'assistant', content:'[Nota de la aplicación: '+m.t+']'});
    });
    raw.pop(); // el último mensaje del usuario se reemplaza por el de contexto
    var hist = raw.slice(-10);
    while(hist.length && hist[0].role!=='user') hist.shift();
    var turns = [];
    hist.concat([{role:'user', content:ctx}]).forEach(function(t){
      var l = turns[turns.length-1];
      if(l && l.role===t.role) l.content += '\n'+t.content; else turns.push({role:t.role, content:t.content});
    });
    turns[0].content = AS_RULES+'\n\n'+turns[0].content;
    return turns;
  }

  // ---- del plan a cambios concretos (todo lo decide la aplicación, no el modelo) ----
  function asBuild(plan){
    var acc = new Map(), noEnc = [], avisos = [], lineas = [], dup = 0;
    function get(vin){ var a = acc.get(vin); if(!a){ a = {f:{}}; acc.set(vin, a); } return a; }
    function colIdx(heads, name){ if(!name) return -1; var k = normH(name); for(var i=0;i<heads.length;i++){ if(normH(heads[i])===k) return i; } return -1; }
    var A = plan.archivo, creaNuevos = false;
    if(A && typeof A==='object' && (A.nombre||A.hoja)){
      var fl = AS.files.filter(function(f){ return normH(f.name)===normH(A.nombre); })[0] || (AS.files.length===1 ? AS.files[0] : null);
      if(!fl){ avisos.push('No encontré el archivo «'+(A.nombre||'')+'» entre los adjuntos.'); }
      else {
        var sn = fl.wb.SheetNames.filter(function(s){ return normH(s)===normH(A.hoja); })[0] || (fl.wb.SheetNames.length===1 ? fl.wb.SheetNames[0] : null);
        if(!sn){ avisos.push('No encontré la hoja «'+(A.hoja||'')+'» en '+fl.name+'.'); }
        else {
          var g = XLSX.utils.sheet_to_json(fl.wb.Sheets[sn], {header:1, defval:'', raw:true}), hi = 0, cv = -1, heads = [];
          for(var i=0;i<Math.min(g.length,20);i++){ var hh = (g[i]||[]).map(asCell); var ci = colIdx(hh, A.col_vin); if(ci>-1){ hi = i; cv = ci; heads = hh; break; } }
          if(cv<0){ avisos.push('No encontré la columna del VIN («'+(A.col_vin||'')+'») en la hoja «'+sn+'».'); }
          else {
            var C = A.columnas || {}, ix = {};
            Object.keys(C).forEach(function(k){ if(C[k]){ var j = colIdx(heads, C[k]); if(j>-1) ix[k] = j; else avisos.push('La columna «'+C[k]+'» ('+k+') no existe en la hoja; se ignora.'); } });
            creaNuevos = A.crear_nuevos===true;
            var seen = {}, filas = 0;
            g.slice(hi+1).forEach(function(r, n){
              var vin = sanitizeVin(r[cv]); if(!vin) return;
              if(vin.length<11){ avisos.push('Fila '+(hi+n+2)+': VIN incompleto «'+vin+'» (se omite).'); return; }
              if(seen[vin]) dup++; seen[vin] = true; filas++;
              var f = get(vin).f;
              if(ix.ubicacion!=null){ var u = asUbic(r[ix.ubicacion]); if(u){ f.estado = u.estado; f.locacion = u.locacion; f._fromUbic = true; if(u.transportadora) f.transportadora = u.transportadora; } }
              if(ix.transportadora!=null){ var tr = cStr(r[ix.transportadora]); if(tr) f.transportadora = tr.slice(0,60); }
              if(ix.fecha_matricula!=null){ var fm = asDate(r[ix.fecha_matricula]); if(fm) f.fecha_matricula = fm; }
              if(ix.fecha_llegada!=null){ var fll = asDate(r[ix.fecha_llegada]); if(fll) f.fecha_llegada = fll; }
              if(ix.fecha_entrega!=null){ var fe = asDate(r[ix.fecha_entrega]); if(fe) f.fecha_entrega = fe; }
              if(ix.en_quiter!=null){ var q = asCell(r[ix.en_quiter]); if(asYes(q, A.valor_quiter_si)) f.en_stock_quiter = true; else if(!q && A.quiter_vacio_es_no===true) f.en_stock_quiter = false; }
              if(ix.consignacion!=null && asYes(r[ix.consignacion])) f.consignacion = true;
              if(ix.facturado!=null && asYes(r[ix.facturado])) f.facturado = true;
              if(ix.observaciones!=null){ var ob = normH(asCell(r[ix.observaciones])); if(ob.indexOf('consignacion')>-1) f.consignacion = true; if(ob.indexOf('facturacliente')>-1) f.facturado = true; }
              ['marca','referencia','color'].forEach(function(k){ if(ix[k]!=null){ var s = cStr(r[ix[k]]); if(s) f[k] = s.slice(0,80); } });
            });
            lineas.push('Archivo «'+fl.name+'» · hoja «'+sn+'»: '+filas+' filas con VIN'+(dup? ' ('+dup+' repetidos, se usa el último)':'')+'. Columnas: '+Object.keys(ix).join(', ')+'.');
          }
        }
      }
    }
    var ops = Array.isArray(plan.operaciones) ? plan.operaciones.slice(0,40) : [];
    ops.forEach(function(op, oi){
      var as = op.asignar || {}, d = op.donde || {}, vins = (Array.isArray(op.vins) ? op.vins : []).map(sanitizeVin).filter(Boolean);
      var tiene = function(o, k){ return o[k]!==undefined && o[k]!==null && o[k]!==''; };
      var hasFilter = ['estado','locacion','marca','matriculado','en_quiter','consignacion','facturado'].some(function(k){ return tiene(d,k); });
      var desc = String(op.descripcion||('Operación '+(oi+1))).slice(0,140);
      if(!vins.length && !hasFilter){ avisos.push('«'+desc+'» no indica VIN ni filtro: se omite.'); return; }
      var f = {};
      var ub = as.ubicacion!=null && as.ubicacion!=='' ? as.ubicacion : as.locacion;
      if(ub!=null && cStr(ub)){ var u = asUbic(ub); if(u){ f.estado = u.estado; f.locacion = u.locacion; if(u.transportadora) f.transportadora = u.transportadora; } }
      if(tiene(as,'estado')){
        if(AS_ESTADOS.indexOf(as.estado)<0){ avisos.push('«'+desc+'»: estado «'+as.estado+'» no válido (se omite).'); return; }
        f.estado = as.estado; if(as.estado==='entregado') f.locacion = '';
      }
      ['fecha_matricula','fecha_llegada','fecha_entrega'].forEach(function(k){
        if(tiene(as,k)){ var dd = asDate(as[k]); if(dd) f[k] = dd; else avisos.push('«'+desc+'»: fecha no válida en '+k+' («'+as[k]+'»).'); }
      });
      if(tiene(as,'matricula_estado')){ if(MATRICULA_ESTADOS.indexOf(as.matricula_estado)>-1) f.matricula_estado = as.matricula_estado; else avisos.push('«'+desc+'»: matrícula «'+as.matricula_estado+'» no válida.'); }
      if(typeof as.en_quiter==='boolean') f.en_stock_quiter = as.en_quiter;
      if(typeof as.consignacion==='boolean') f.consignacion = as.consignacion;
      if(typeof as.facturado==='boolean') f.facturado = as.facturado;
      ['transportadora','marca','referencia','color'].forEach(function(k){ if(tiene(as,k)) f[k] = cStr(as[k]).slice(0,80); });
      if(!Object.keys(f).length){ avisos.push('«'+desc+'» no indica qué cambiar: se omite.'); return; }
      function pasa(v){
        if(tiene(d,'estado') && v.estado!==d.estado) return false;
        if(tiene(d,'locacion') && normH(v.locacion)!==normH(d.locacion)) return false;
        if(tiene(d,'marca') && normH(v.marca)!==normH(d.marca)) return false;
        if(typeof d.matriculado==='boolean' && isMat(v)!==d.matriculado) return false;
        if(typeof d.en_quiter==='boolean' && (v.en_stock_quiter===true)!==d.en_quiter) return false;
        if(typeof d.consignacion==='boolean' && (v.consignacion===true)!==d.consignacion) return false;
        if(typeof d.facturado==='boolean' && (v.facturado===true)!==d.facturado) return false;
        return true;
      }
      var targets = [];
      if(vins.length){
        vins.forEach(function(vin){ var v = findByVin(vin); if(!v){ if(noEnc.indexOf(vin)<0) noEnc.push(vin); } else if(pasa(v)) targets.push(sanitizeVin(v.vin||v.vid)); });
      } else {
        vehiclesArr().forEach(function(v){ if((tiene(d,'estado') || !esSalida(v)) && pasa(v)) targets.push(sanitizeVin(v.vin||v.vid)); });
      }
      targets.forEach(function(vin){ var a = get(vin); Object.keys(f).forEach(function(k){ a.f[k] = f[k]; }); if(f.estado) delete a.f._fromUbic; });
      lineas.push(desc+' → '+targets.length+' vehículo'+(targets.length===1?'':'s'));
    });
    // ---- calcular el cambio real por vehículo ----
    var changes = [], same = 0, nuevos = 0;
    acc.forEach(function(a, vin){
      var v = findByVin(vin), f = a.f;
      if(!v && !creaNuevos){ if(noEnc.indexOf(vin)<0) noEnc.push(vin); return; }
      var cur = v || Object.assign(blankVeh(vin), {en_stock_quiter:false, alertas:[]});
      var upd = {}, cb = [];
      var est = f.estado, loc = f.locacion;
      if(est && f._fromUbic && v && cur.locacion===loc && ['entregado','transito','por_transportar','sin_liberar'].indexOf(est)<0) est = cur.estado;
      if(est && est!==cur.estado){ upd.estado = est; cb.push('Estado: '+asLbl(cur.estado)+' → '+asLbl(est)); }
      if(loc!==undefined && loc!==(cur.locacion||'')){ upd.locacion = loc; cb.push('Ubicación: '+(cur.locacion||'—')+' → '+(loc||'—')); }
      var estFinal = upd.estado || cur.estado;
      if(upd.estado==='entregado'){
        if(cur.locacion) upd.ubic_anterior = cur.locacion;
        if(cur.bodega) upd.bodega = '';
        if(!f.fecha_entrega && !cur.fecha_entrega){ upd.fecha_entrega = todayISO(); cb.push('Fecha de entrega: '+upd.fecha_entrega); }
      }
      function put(k, val, label){ if(val!==undefined && val!==(cur[k]||'')){ upd[k] = val; cb.push(label+': '+(cur[k]||'—')+' → '+(val||'—')); } }
      put('transportadora', f.transportadora, 'Transportadora');
      put('fecha_llegada', f.fecha_llegada, 'Fecha de llegada');
      put('fecha_entrega', f.fecha_entrega, 'Fecha de entrega');
      if(f.fecha_matricula && f.fecha_matricula!==cur.fecha_matricula){
        upd.fecha_matricula = f.fecha_matricula; cb.push('Fecha de matrícula: '+(cur.fecha_matricula||'—')+' → '+f.fecha_matricula);
        if(!f.matricula_estado && cur.matricula_estado!=='Matriculado'){ upd.matricula_estado = 'Matriculado'; cb.push('Matrícula: '+(cur.matricula_estado||'—')+' → Matriculado'); }
      }
      if(f.matricula_estado && f.matricula_estado!==cur.matricula_estado){ upd.matricula_estado = f.matricula_estado; cb.push('Matrícula: '+(cur.matricula_estado||'—')+' → '+f.matricula_estado); }
      [['en_stock_quiter','En Quiter'],['consignacion','Consignación'],['facturado','Facturado']].forEach(function(p){
        if(typeof f[p[0]]==='boolean' && f[p[0]]!==(cur[p[0]]===true)){ upd[p[0]] = f[p[0]]; cb.push(p[1]+': '+(cur[p[0]]===true?'sí':'no')+' → '+(f[p[0]]?'sí':'no')); }
      });
      put('marca', f.marca, 'Marca'); put('referencia', f.referencia, 'Referencia'); put('color', f.color, 'Color');
      if(!v){ nuevos++; changes.push({vin:vin, vid:vin, nuevo:true, ref:f.referencia||'', upd:upd, cambios:['Vehículo nuevo'].concat(cb), estFinal:estFinal}); return; }
      if(!cb.length){ same++; return; }
      changes.push({vin:vin, vid:v.vid, nuevo:false, ref:(v.referencia && normH(v.referencia).indexOf(normH(v.marca))===0 ? v.referencia : ((v.marca||'')+' '+(v.referencia||'')).trim()), upd:upd, cambios:cb, estFinal:estFinal});
    });
    return {changes:changes, same:same, nuevos:nuevos, noEnc:noEnc, avisos:avisos.slice(0,12), lineas:lineas, resumen:String(plan.resumen||'')};
  }

