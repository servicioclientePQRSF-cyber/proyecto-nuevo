  // ---------- archivo de Stock Quiter solo (STOK .xls): actualiza el stock sin tocar ubicaciones ----------
  var ALERT_OUT_STOCK = 'Ya no figura en Stock Quiter (posible facturación o salida): confirma';
  var ALERT_ONLY_STOCK = 'Solo está en Stock Quiter: falta en el conteo físico';
  function detectStock(wb){
    var best = null;
    wb.SheetNames.forEach(function(n){
      var g = XLSX.utils.sheet_to_json(wb.Sheets[n], {header:1, defval:'', raw:true});
      for(var i=0;i<Math.min(g.length,10);i++){
        var map = {}; g[i].forEach(function(h,j){ var k = normH(h); if(k && map[k]==null) map[k] = j; });
        if(map.bastidor==null && map.vin!=null) map.bastidor = map.vin;
        if(map.bastidor!=null && map.modelo!=null && (map.fraproveedo!=null || map.tcosto!=null || map.pvd!=null)){
          var cD = map.frecep!=null ? map.frecep : map.fadjud, mx = '', cnt = 0;
          g.slice(i+1).forEach(function(r){ if(sanitizeVin(r[map.bastidor]).length>=11){ cnt++; var d = cD!=null ? cDate(r[cD]) : ''; if(d>mx) mx = d; } });
          if(!best || mx>best.mx || (mx===best.mx && cnt>best.cnt)) best = {name:n, g:g, hi:i, map:map, mx:mx, cnt:cnt};
          break;
        }
      }
    });
    return best;
  }
  function blankVeh(vin){
    return {vin:vin, marca:'', referencia:'', color:'', estado:'sin_ubicacion', locacion:'', ubic_fuente:'', ubic_anterior:'', matricula_estado:'No matriculado', placa:'',
      fecha_matricula:'', fecha_entrega:'', fecha_llegada:'', en_stock_quiter:true, consignacion:false, matriz_ok:false, transportadora:'', origen:'', fecha_compromiso:'',
      test_drive:false, alistamiento_taller:'', alistamiento_ingreso:'', alistamiento_salida:'', alertas:[ALERT_ONLY_STOCK]};
  }
  function buildStock(st){
    var res = {cambios:[], nuevos:[], iguales:[], ausentes:[], errores:[], alertas:[], fuera:[], repetidos:0, stat:{}};
    var m = st.map, seen = {}, cD = m.frecep!=null ? m.frecep : m.fadjud, ya = 0;
    st.g.slice(st.hi+1).forEach(function(r,idx){
      var line = st.hi+idx+2, vin = sanitizeVin(r[m.bastidor]); if(!vin) return;
      if(vin.length<11){ res.errores.push({line:line, vin:vin, msg:'VIN incompleto (menos de 11 caracteres)'}); return; }
      if(seen[vin]) res.repetidos++; seen[vin] = true;
      var marca = m.marca!=null ? cStr(r[m.marca]) : '', modelo = cStr(r[m.modelo]), color = m.color!=null ? cStr(r[m.color]) : '', fec = cD!=null ? cDate(r[cD]) : '';
      var v = findByVin(vin);
      if(!v){
        res.fuera.push({vin:vin, hoja:st.name, detalle:'En el stock de Quiter ('+(modelo||'—')+'), pero no está en el inventario (no figura en el conteo actual): no se agrega.'}); return;
      }
      ya++;
      var upd = {}, cambios = [];
      if(!v.en_stock_quiter){ upd.en_stock_quiter = true; cambios.push('Vuelve a figurar en Stock Quiter'); }
      if(!v.marca && marca){ upd.marca = marca; cambios.push('Marca: '+marca); }
      if(!v.referencia && modelo){ upd.referencia = modelo; cambios.push('Referencia: '+modelo); }
      if(!v.color && color){ upd.color = color; cambios.push('Color: '+color); }
      if(!v.fecha_llegada && fec){ upd.fecha_llegada = fec; cambios.push('Fecha de llegada: '+fec); }
      var al = v.alertas||[], limpio = al.filter(function(a){ return a!==ALERT_OUT_STOCK; });
      if(limpio.length!==al.length){ upd.alertas = limpio; cambios.push('Se quita la alerta de salida de stock'); }
      var entry = {vin:vin, vid:v.vid, line:line, ref:v.referencia||modelo||'', upd:upd, cambios:cambios};
      if(cambios.length) res.cambios.push(entry); else res.iguales.push(entry);
    });
    var salieron = 0;
    vehiclesArr().forEach(function(v){
      var k = sanitizeVin(v.vin||v.vid);
      if(seen[k] || !v.en_stock_quiter || esSalida(v)) return;
      salieron++;
      var al = (v.alertas||[]).filter(function(a){ return a!==ALERT_OUT_STOCK; }).concat([ALERT_OUT_STOCK]);
      res.cambios.push({vin:k, vid:v.vid, line:'', ref:v.referencia||'', upd:{en_stock_quiter:false, alertas:al}, cambios:['Ya no figura en Stock Quiter (posible facturación o salida)']});
    });
    res.stat = {total:Object.keys(seen).length, ya:ya, nuevos:res.nuevos.length, salieron:salieron, mx:st.mx};
    return res;
  }
