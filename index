    var res = buildStock(st); res.omitidos = []; res.noenc = [];
    U.res = res;
    var m = st.map, cD = m.frecep!=null ? m.frecep : m.fadjud, rows = [], seen = {}, vals = [];
    st.g.slice(st.hi+1).forEach(function(r){
      var vin = sanitizeVin(r[m.bastidor]); if(vin.length<11 || seen[vin]) return; seen[vin] = 1;
      rows.push([vin, m.marca!=null ? cStr(r[m.marca]) : '', cStr(r[m.modelo]), m.color!=null ? cStr(r[m.color]) : '', cD!=null ? cDate(r[cD]) : '']);
      if(m.pvd!=null || m.total!=null || m.tcosto!=null || m.ano!=null){
        var nv = function(c){ if(c==null) return 0; var x = r[c]; if(typeof x==='number') return Math.round(x); x = parseFloat(String(x||'').replace(/[^0-9.\-]/g,'')); return isNaN(x) ? 0 : Math.round(x); };
        vals.push([vin, nv(m.pvd), nv(m.iva), nv(m.total), nv(m.rectifi), nv(m.imptaller), nv(m.tcosto), nv(m.ano)]);
      }
    });
    U.stokRows = rows; U.stokVals = vals;
    var prev = {}; STOK_REF.forEach(function(r){ prev[vsNorm(r[0])] = 1; });
    var now = {}; rows.forEach(function(r){ now[vsNorm(r[0])] = 1; });
    var add = rows.filter(function(r){ return !prev[vsNorm(r[0])]; }).length, quit = STOK_REF.filter(function(r){ return !now[vsNorm(r[0])]; }).length;
    U.info = 'Stock Quiter reconocido · hoja «'+st.name+'» · '+rows.length+' VIN (recepciones hasta '+(st.mx||'—')+'). Frente al STOK que usa el panel: '+add+' VIN nuevos en el stock y '+quit+' que ya no figuran.';
