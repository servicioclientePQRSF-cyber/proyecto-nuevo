  }

  // descripción comercial a partir de un texto del ERP: quita códigos de modelo («BL1A70__24G1601», «HQS6K2615HBATT»)
  function cleanDesc(v){
    var t = cStr(v); if(!t) return '';
    return t.split(' ').filter(function(w){
      if(!w) return false;
      if(/_/.test(w)) return false;
      if(/^[A-Z0-9]{8,}$/.test(w) && /\d/.test(w) && /[A-Z]/.test(w)) return false;
      return true;
