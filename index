  function openDrawer(id){
    currentVid = id;
    renderDrawerBody();
    drawer.classList.add('open'); overlay.classList.add('open');
  }

  async function docRef(id){ return db.collection('vehicles').doc(id); }

  // ---------- «Entregado»: confirma la fecha y el vehículo sale del inventario al instante ----------
  function openEntregado(id){
    var v = vehicles.get(id); if(!v) return;
    if(!(perm && perm.editInventario)) return;
    overlay.classList.add('open');
    caseModal.innerHTML =
      '<div class="form-title">Marcar como entregado</div>'+
      '<div class="form-desc mono" style="word-break:break-all;">'+esc(vinText(v))+'</div>'+
      '<p style="font-size:13px;margin:6px 0;">'+esc(vehTitle(v))+(v.color? ' · '+esc(v.color):'')+(v.locacion? ' · hoy en '+esc(v.locacion) : '')+'</p>'+
      '<div class="readonly-note">Al confirmar, el vehículo sale del inventario de inmediato.</div>'+
      '<label class="field" style="margin-top:10px;">Fecha de entrega<input type="date" id="ent_fecha" value="'+esc(v.fecha_entrega||todayISO())+'"></label>'+
      '<div style="margin-top:14px;display:flex;gap:8px;justify-content:flex-end;">'+
      '<button class="btn ghost" id="ent_cancel" type="button">Cancelar</button>'+
      '<button class="btn primary" id="ent_ok" type="button">Confirmar entrega</button></div>';
    caseModalWrap.classList.add('open');
    document.getElementById('ent_cancel').addEventListener('click', closeCaseModal);
    document.getElementById('ent_ok').addEventListener('click', function(){ marcarEntregado(id, document.getElementById('ent_fecha').value || todayISO()); });
  }
  function openEntregadoSel(){
    if(!(perm && perm.editInventario)) return;
    var ids = Array.from(invSel).filter(function(id){ var v = vehicles.get(id); return v && !esSalida(v); }); if(!ids.length) return;
    overlay.classList.add('open');
    caseModal.innerHTML =
      '<div class="form-title">Marcar '+ids.length+(ids.length===1?' vehículo':' vehículos')+' como entregado'+(ids.length===1?'':'s')+'</div>'+
      '<div class="readonly-note">Al confirmar, salen del inventario de inmediato.</div>'+
      '<label class="field" style="margin-top:10px;">Fecha de entrega<input type="date" id="ent_fecha" value="'+todayISO()+'"></label>'+
      '<div style="margin-top:14px;display:flex;gap:8px;justify-content:flex-end;">'+
      '<button class="btn ghost" id="ent_cancel" type="button">Cancelar</button>'+
      '<button class="btn primary" id="ent_ok" type="button">Confirmar entrega</button></div>';
    caseModalWrap.classList.add('open');
    document.getElementById('ent_cancel').addEventListener('click', closeCaseModal);
    document.getElementById('ent_ok').addEventListener('click', async function(){
      var f = document.getElementById('ent_fecha').value || todayISO(), btn = this; btn.disabled = true; var ok = 0, bad = 0;
      for(var i=0;i<ids.length;i++){ if(await marcarEntregado(ids[i], f, true)) ok++; else bad++; }
      invSel.clear(); closeCaseModal(); renderInventario();
      toast(ok+(ok===1?' vehículo entregado':' vehículos entregados')+': salen del inventario'+(bad? ' ('+bad+' no se pudieron guardar)':''));
    });
  }
  // ---------- «Cesión de inventario»: el VIN sale del inventario al instante (como Entregado, pero no es una venta al cliente) ----------
  function openCesion(ids){
    if(!(perm && perm.editInventario)) return;
    ids = (ids||[]).filter(function(id){ var v = vehicles.get(id); return v && !esSalida(v); }); if(!ids.length) return;
    var v1 = ids.length===1 ? vehicles.get(ids[0]) : null;
    overlay.classList.add('open');
    caseModal.innerHTML =
      '<div class="form-title">Cesión de inventario'+(ids.length>1 ? ' · '+ids.length+' vehículos' : '')+'</div>'+
      (v1 ? '<div class="form-desc mono" style="word-break:break-all;">'+esc(vinText(v1))+'</div><p style="font-size:13px;margin:6px 0;">'+esc(vehTitle(v1))+(v1.color? ' · '+esc(v1.color):'')+(v1.locacion? ' · hoy en '+esc(v1.locacion) : '')+'</p>' : '')+
      '<div class="readonly-note">Al confirmar, '+(ids.length===1 ? 'el VIN sale' : 'los VIN salen')+' del inventario de inmediato y ya no se cuenta'+(ids.length===1?'':'n')+' en ninguna parte.</div>'+
      '<label class="field" style="margin-top:10px;">Fecha de la cesión<input type="date" id="ces_fecha" value="'+todayISO()+'"></label>'+
      '<label class="field" style="margin-top:8px;">A quién o a dónde se cede (opcional)<input type="text" id="ces_dest" maxlength="160" placeholder="Ej. Otra sucursal, otro concesionario"></label>'+
      '<div style="margin-top:14px;display:flex;gap:8px;justify-content:flex-end;">'+
      '<button class="btn ghost" id="ces_cancel" type="button">Cancelar</button>'+
      '<button class="btn primary" id="ces_ok" type="button">Confirmar cesión</button></div>';
    caseModalWrap.classList.add('open');
    document.getElementById('ces_cancel').addEventListener('click', closeCaseModal);
    document.getElementById('ces_ok').addEventListener('click', async function(){
      var f = document.getElementById('ces_fecha').value || todayISO(), dest = document.getElementById('ces_dest').value.trim(), btn = this; btn.disabled = true; var ok = 0, bad = 0;
      for(var i=0;i<ids.length;i++){ if(await marcarCesion(ids[i], f, dest)) ok++; else bad++; }
      invSel.clear(); closeCaseModal(); if(currentVid && ids.indexOf(currentVid)>-1) closeDrawer(); renderInventario();
      toast(ok+(ok===1?' vehículo cedido':' vehículos cedidos')+': salen del inventario'+(bad? ' ('+bad+' no se pudieron guardar)':''));
    });
  }
  async function marcarCesion(id, fecha, dest){
    var v = vehicles.get(id); if(!v || !db) return false;
    var upd = {estado:'cesion', locacion:'', bodega:'', fecha_cesion:fecha, destino_cesion:dest||'', actualizado:new Date().toISOString(),
      historial: pushHist(v, 'Cesión de inventario', ((ESTADOS[v.estado]||{}).label||'Sin información')+' → Cesión de inventario'+(v.locacion? ' (estaba en '+v.locacion+')':'')+' · '+fmtDate(fecha)+(dest? ' · '+dest : ''))};
    if(v.locacion) upd.ubic_anterior = v.locacion;
    try{ await (await docRef(id)).update(upd); return true; }catch(e){ return false; }
  }
  async function marcarEntregado(id, fecha, quiet){
    var v = vehicles.get(id); if(!v||!db) return;
    if(!(perm && perm.editInventario)) return;
    var btn = quiet ? null : document.getElementById('ent_ok'); if(btn) btn.disabled = true;
    var upd = {estado:'entregado', locacion:'', bodega:'', fecha_entrega:fecha, actualizado:new Date().toISOString(),
      historial: pushHist(v, 'Entregado', ((ESTADOS[v.estado]||{}).label||'Sin información')+' → Entregado'+(v.locacion? ' (estaba en '+v.locacion+')':'')+' · fecha de entrega '+fmtDate(fecha))};
    if(v.locacion) upd.ubic_anterior = v.locacion;
    try{
      await (await docRef(id)).update(upd);
      if(quiet) return true;
      closeCaseModal();
      if(currentVid===id) closeDrawer();
      toast('Entregado: sale del inventario');
      return true;
    }catch(e){ if(quiet) return false; toast('No se pudo guardar: '+(e&&e.message||e)); if(btn) btn.disabled = false; return false; }
  }

  async function saveEstado(id){
    var v = vehicles.get(id); if(!v||!db) return;
    if(!(perm && perm.editInventario)) return;
    var estado = document.getElementById('d_estado').value;
    var locacion = document.getElementById('d_locacion').value;
    var bodega = estado==='bodega' ? document.getElementById('d_bodega').value.trim() : '';
    var prevEstado = v.estado, prevLoc = v.locacion;
    var hist = (v.historial||[]).slice();
    if(estado!==prevEstado || locacion!==prevLoc){
      hist = pushHist(v, 'Cambio de estado', ((ESTADOS[prevEstado]||{}).label||'Sin información')+' → '+((ESTADOS[estado]||{}).label||'Sin información') + (locacion!==prevLoc? ' · sede: '+locacion : ''));
    }
    try{
      await (await docRef(id)).update({estado:estado, locacion:locacion, bodega:bodega, historial:hist, actualizado:new Date().toISOString()});
      toast('Estado guardado');
    }catch(e){ toast('No se pudo guardar: '+(e&&e.message||e)); }
  }

  async function saveMatricula(id){
    var v = vehicles.get(id); if(!v||!db) return;
    if(!(perm && perm.editInventario)) return;
    var vin = sanitizeVin(document.getElementById('d_vin').value);
    var other = vin ? findByVin(vin) : null;
    if(other && other.vid!==id){ toast('Ese VIN ya pertenece a otro vehículo del inventario.'); return; }
    var upd = {
      vin: vin,
      placa: sanitizePlaca(document.getElementById('d_placa').value),
      matricula_estado: document.getElementById('d_mat').value==='__cesion' ? (v.matricula_estado||'') : document.getElementById('d_mat').value==='__fact' ? (v.matricula_estado||'No matriculado') : document.getElementById('d_mat').value,
      fecha_matricula: document.getElementById('d_fmat').value,
      orden_pedido: document.getElementById('d_orden').value.trim(),
      fecha_facturacion: document.getElementById('d_ffact').value,
      facturado: document.getElementById('d_fact').checked,
      actualizado: new Date().toISOString()
    };
    var cambios = [];
    if((v.matricula_estado||'')!==upd.matricula_estado) cambios.push('matrícula: '+(upd.matricula_estado||'Sin información'));
    if((v.facturado===true)!==upd.facturado) cambios.push(upd.facturado?'marcado como facturado':'facturado desmarcado');
    if((v.orden_pedido||'')!==upd.orden_pedido) cambios.push('orden de pedido: '+(upd.orden_pedido||'—'));
    if((v.placa||'')!==upd.placa) cambios.push('placa: '+(upd.placa||'—'));
    if((v.vin||'')!==upd.vin) cambios.push('VIN: '+(upd.vin||'—'));
    if(cambios.length) upd.historial = pushHist(v, 'Matrícula / facturación', cambios.join(' · '));
    try{
      await (await docRef(id)).update(upd);
      toast('Matrícula y facturación guardadas');
    }catch(e){ toast('No se pudo guardar: '+(e&&e.message||e)); }
  }

  async function saveMatDate(id){
    var v = vehicles.get(id); if(!v||!db) return;
    if(!(perm && perm.editMatDate)) return;
    var nf = document.getElementById('d_fmat').value;
    if((v.fecha_matricula||'')===nf){ toast('La fecha no cambió'); return; }
    var upd = {fecha_matricula:nf, actualizado:new Date().toISOString(),
      historial: pushHist(v,'Fecha de matrícula','Fecha de matrícula: '+(v.fecha_matricula? fmtDate(v.fecha_matricula):'—')+' → '+(nf? fmtDate(nf):'—'))};
    try{ await (await docRef(id)).update(upd); toast('Fecha de matrícula guardada'); }
    catch(e){ toast('No se pudo guardar: '+(e&&e.message||e)); }
  }

  async function unassign(id){
    var v = vehicles.get(id); if(!v||!db) return;
    if(!(perm && perm.assign)) return;
    try{
      await (await docRef(id)).update({asignado:false, asig_gerente:'', asig_marca:'', asig_soporte:'', asig_cliente:'', actualizado:new Date().toISOString(),
        historial: pushHist(v,'Asignación comercial','Se quitó la asignación a '+(v.asig_gerente||'—'))});
      toast('Asignación retirada');
    }catch(e){ toast('No se pudo quitar la asignación: '+(e&&e.message||e)); }
  }

  async function saveChecklist(id){
    var v = vehicles.get(id); if(!v||!db) return;
    if(!(perm && perm.editInventario)) return;
    var checklist = {fecha:new Date().toISOString(), responsable: operatorName||'—'};
    CHK_FIELDS.forEach(function(f){
      checklist[f[0]] = !!document.querySelector('[data-chk="'+f[0]+'"]').checked;
    });
    try{
