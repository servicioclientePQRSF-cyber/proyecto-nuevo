      upRows.slice(0,200).map(function(r){
        var quedara = r.update ? esc(r.update.asig_soporte)+' → '+esc(r.update.asig_gerente)+(r.update.asig_marca?' ('+esc(r.update.asig_marca)+')':'') : '—';
        var result = r.error ? esc(r.error) : (r.skip ? 'Repetida en el archivo; se usa la última fila.' : 'OK');
        return '<tr'+(r.error?' class="err"':'')+'><td class="mono">'+r.line+'</td><td class="mono" style="word-break:break-all;">'+esc(r.vin||r.row.vinRaw||'—')+'</td><td>'+esc(r.v? (r.v.referencia||'Sin referencia') : '—')+'</td><td>'+quedara+'</td><td>'+result+'</td></tr>';
      }).join('')+'</tbody></table></div>'+(upRows.length>200? '<div class="helptext">Se muestran las primeras 200 filas; se aplican todas las válidas.</div>':'');
    wrap.innerHTML = html;
