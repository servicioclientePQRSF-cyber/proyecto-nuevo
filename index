<script>
(function(){
  "use strict";

  // ---------- roles & permissions ----------
  var ROLE_CREDENTIALS = {
    jefe_operaciones:   {label:'Jefe de Operaciones',  user:'jefe.operaciones',   password:'Operaciones2026*'},
    coordinador_pdi:    {label:'Coordinador PDI',      user:'coordinador.pdi',    password:'CoordPDI2026*'},
    asesor_colision:    {label:'Asesor de Colisión',   user:'asesor.colision',    password:'Colision2026*'},
    gerente_kia:        {label:'Gerente Kia',          user:'gerente.kia',        password:'Kia2026*'},
    gerente_hyundai:    {label:'Gerente Hyundai',      user:'gerente.hyundai',    password:'Hyundai2026*'},
    gerente_byd:        {label:'Gerente BYD',          user:'gerente.byd',        password:'BYD2026*'},
    gerente_premium:    {label:'Gerente Premium',      user:'gerente.premium',    password:'Premium2026*'},
    gerente_productivos:{label:'Gerente Productivos',  user:'gerente.productivos',password:'Productivos2026*'},
    gerente_ipiales:    {label:'Gerente Ipiales',      user:'gerente.ipiales',    password:'Ipiales2026*'},
    presidencia:        {label:'Presidencia',          user:'presidencia',        password:'Presidencia2026*'},
    vicepresidencia:    {label:'Vicepresidencia',      user:'vicepresidencia',    password:'Vicepresidencia2026*'},
    gerencia:           {label:'Gerencia',             user:'gerencia',           password:'Gerencia2026*'},
    auditoria:          {label:'Auditoría',            user:'auditoria',          password:'Auditoria2026*'}
  };
  // Permisos por perfil. tabs = pestañas visibles; las acciones se controlan con las banderas.
  //  editInventario: ubicación, estado, matrícula, checklist, VIN · editCasos: cotización y estado del caso · reportNovedad · requestJobs · assign · approveJobs · importInv
  //  comment: comentar casos · prioridad: marcar casos como prioritarios · editMatDate: solo cambiar la fecha de matrícula · exec: interfaz sencilla (Panorama con gráficas)
  var TABS_VER = ['resumen','pres','vin','dash','inventario','sinstok','invtotal','consig','qfm','qval','apart','porllegar','alist','prest','antig','casos','comercial','trabajos'];
  var NO_ACT = {editInventario:false, editCasos:false, reportNovedad:false, requestJobs:false, assign:false, approveJobs:false, importInv:false, comment:false, prioridad:false, editMatDate:false, exec:false, apartar:false, asesorTag:false, adminUsuarios:false, colision:false, aprobarCot:false};
  function permDe(tabs, extra){ return Object.assign({tabs:tabs.slice()}, NO_ACT, extra||{}); }
  var ROLE_PERMS = {
    jefe_operaciones:   permDe(TABS_VER.concat(['cargas','importar','asistente','nuevo','usuarios']), {adminUsuarios:true, editInventario:true, editCasos:true, reportNovedad:true, requestJobs:true, assign:true, approveJobs:true, importInv:true, comment:true, prioridad:true, editMatDate:true, apartar:true, asesorTag:true, aprobarCot:true}),
    coordinador_pdi:    permDe(TABS_VER.concat(['cargas','importar','asistente','nuevo']), {editInventario:true, editCasos:true, reportNovedad:true, requestJobs:true, assign:true, approveJobs:true, importInv:true, comment:true, prioridad:true, editMatDate:true, apartar:true, asesorTag:true, aprobarCot:true}),
    asesor_colision:    permDe(['resumen','pres','vin','dash','inventario','sinstok','invtotal','consig','qfm','apart','porllegar','antig','casos','trabajos'], {editCasos:true, colision:true, comment:true}),
    // gerentes de marca: mismos permisos que tenía Gerencia Comercial, pero apartan y ponen asesor solo en SUS marcas (marcasApart). Ipiales solo consulta.
    gerente_kia:        permDe(TABS_VER, {comment:true, prioridad:true, editMatDate:true, apartar:true, asesorTag:true, marcasApart:['KIA'], marcasVer:['KIA']}),
    gerente_hyundai:    permDe(TABS_VER, {comment:true, prioridad:true, editMatDate:true, apartar:true, asesorTag:true, marcasApart:['HYUNDAI'], marcasVer:['HYUNDAI']}),
    gerente_byd:        permDe(TABS_VER, {comment:true, prioridad:true, editMatDate:true, apartar:true, asesorTag:true, marcasApart:['BYD'], marcasVer:['BYD']}),
    gerente_premium:    permDe(TABS_VER, {comment:true, prioridad:true, editMatDate:true, apartar:true, asesorTag:true, marcasApart:['HONDA','JETOUR','MITSUBISHI'], marcasVer:['HONDA','JETOUR','MITSUBISHI']}),
    gerente_productivos:permDe(TABS_VER, {comment:true, prioridad:true, editMatDate:true, apartar:true, asesorTag:true, marcasApart:['JMC','JAC','DFSK','KARRY','VOLKSWAGEN','CITROEN'], marcasVer:['JMC','JAC','DFSK','KARRY','VOLKSWAGEN','CITROEN']}),
    gerente_ipiales:    permDe(TABS_VER, {}),   // ve todo el inventario, solo consulta
    presidencia:        permDe(['panorama'].concat(TABS_VER), {exec:true, apartar:true, asesorTag:true}),
    vicepresidencia:    permDe(['panorama'].concat(TABS_VER), {exec:true, apartar:true, asesorTag:true}),
    gerencia:           permDe(['panorama'].concat(TABS_VER), {exec:true, apartar:true, asesorTag:true}),
    auditoria:          permDe(TABS_VER)
  };
  var MODO_ABIERTO = false;
  var ALL_TABS = ['guia','panorama','resumen','pres','vin','dash','inventario','sinstok','invtotal','consig','qfm','qval','apart','porllegar','alist','prest','antig','casos','comercial','trabajos','cargas','importar','asistente','nuevo','usuarios'];
  Object.keys(ROLE_PERMS).forEach(function(k){ if(ROLE_PERMS[k].tabs.indexOf('guia')<0) ROLE_PERMS[k].tabs.unshift('guia'); });
  var ROLE_BASE = JSON.parse(JSON.stringify(ROLE_PERMS));   // permisos originales de los perfiles fijos
  var currentRole = null, perm = null;
  // los gráficos se actualizan cada vez que cambia una lista o un filtro
  [['alist','renderAlist'],['prest','renderPrest'],['porllegar','renderPorLlegar'],['apart','renderApart'],['consig','renderConsig'],['casos','renderCasos'],['qval','renderQval'],['qfm','renderQfm'],['sinstok','renderNoStok'],['trabajos','renderJobs']].forEach(function(p){
    var tab = p[0], name = p[1];
    try{
      var orig = eval(name);
      var wrapped = function(){ var r = orig.apply(this, arguments); gxRender(tab); return r; };
      eval(name+' = wrapped');
    }catch(e){}
  });

  var tabsEl = document.getElementById('tabs');
  var trabajos = new Map();  // id -> solicitud de trabajo interno
  var importaciones = new Map();

  var ESTADOS = {
    transito:{label:'En tránsito', color:'var(--state-transito)'},
    por_transportar:{label:'Por transportar', color:'var(--state-porT)'},
    sin_liberar:{label:'Sin liberar', color:'var(--state-liberar)'},
    vitrina:{label:'En vitrina', color:'var(--state-vitrina)'},
    bodega:{label:'En bodega / patio', color:'var(--state-bodega)'},
    taller:{label:'En taller / colisión', color:'var(--state-taller)'},
    otra:{label:'Otra ubicación', color:'var(--state-otro)'},
    sin_ubicacion:{label:'Pendiente definir ubicación', color:'var(--state-sinubic)'},
    otro_patio:{label:'Facturado en otro patio', color:'var(--state-otro)'},
    facturado_cliente:{label:'Facturado a cliente final', color:'var(--state-cliente)'},
    entregado:{label:'Entregado', color:'var(--state-entregado)'},
    fuera:{label:'Fuera de inventario', color:'var(--state-fuera)'},
    cesion:{label:'Cesión de inventario', color:'var(--state-fuera)'}
  };
  var ESTADOS_LEGACY = ['otro_patio','facturado_cliente'];
  var GRUPO_SEDES = ['vitrina','bodega','taller','otra'];
  var GRUPO_ORIGEN = ['transito','por_transportar','sin_liberar'];
  var LOC_BASE = ['Postobón','Briceño','Pandiaco','Sion','Vitrina Kia','Vitrina Hyundai','Vitrina Productivos','Vitrina Productivos Catambuco','Vitrina Premium','Vitrina JMC','Vitrina Volkswagen','Vitrina Ipiales','Vitrina Ipiales Entrega','Vitrina Catambuco','Vitrina BYD','Playa Ventas Unicentro','Taller 1','Taller 4','Colisión Novedad','Colisión Préstamo','Devuelto a importadora'];
  var LOCACIONES = LOC_BASE.slice();
  var CASE_ESTADOS = {
    abierta:{label:'Abierta', color:'var(--case-abierta)'},
    cotizada:{label:'Cotizada', color:'var(--case-cotizada)'},
    aprobada:{label:'Aprobada', color:'var(--case-aprobada)'},
    resuelta:{label:'Resuelta', color:'var(--case-resuelta)'}
  };
  var CHK_FIELDS = [
    ['llantas','Llantas y rines'],
    ['pintura','Pintura y carrocería'],
    ['vidrios','Vidrios y espejos'],
    ['interior','Tapicería e interior'],
    ['documentos','Documentos, manual y llaves'],
    ['combustible','Nivel de combustible'],
    ['electricos','Luces y sistemas eléctricos']
  ];
  var MAX_PHOTOS = 5;

  function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
  function todayISO(){ return new Date().toISOString().slice(0,10); }
  function fmtDateTime(iso){
    if(!iso) return '—';
    try{ var d=new Date(iso); return d.toLocaleDateString('es-CO',{day:'2-digit',month:'short'})+' '+d.toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit'}); }catch(e){ return iso; }
  }
  function fmtDate(iso){
    if(!iso) return '—';
    try{ var d=new Date(iso+'T00:00:00'); return d.toLocaleDateString('es-CO',{day:'2-digit',month:'short',year:'numeric'}); }catch(e){ return iso; }
  }
  function fmtMoney(n){
    if(n==null || n==='') return '—';
    try{ return new Intl.NumberFormat('es-CO',{style:'currency',currency:'COP',maximumFractionDigits:0}).format(n); }catch(e){ return '$'+n; }
  }
  function pillHtml(color,label){
    return '<span class="pill" style="background:color-mix(in srgb, '+color+' 16%, transparent); color:'+color+';"><span class="sw" style="background:'+color+';"></span>'+esc(label)+'</span>';
  }
  function sanitizePlaca(v){ return String(v||'').toUpperCase().replace(/[^A-Z0-9\-]/g,'').slice(0,12); }

  // ---------- ingreso: usuario → contraseña · usuarios creados y permisos que decide el Jefe de Operaciones ----------
  var loginGate = document.getElementById('loginGate');
  var loginPassword = document.getElementById('loginPassword');
  var loginError = document.getElementById('loginError');
  var pendingRole = null, pendingUser = '', pendingDoc = null;
  var PERM_FLAGS = [['editInventario','Editar el inventario (ubicación, estado, matrícula, checklist)'],['editCasos','Cotizar y cambiar el estado de los casos'],['reportNovedad','Reportar novedades'],['requestJobs','Solicitar trabajos internos'],['approveJobs','Aprobar o rechazar trabajos internos'],['assign','Asignar vehículos a gerentes'],['importInv','Cargar y actualizar el inventario con archivos'],['comment','Comentar casos'],['prioridad','Marcar casos como prioritarios'],['editMatDate','Cambiar la fecha de matrícula'],['apartar','Poner la etiqueta de apartado'],['asesorTag','Poner el nombre del asesor'],['exec','Vista ejecutiva (Panorama con gráficas)'],['colision','Colisión: subir cotizaciones, responder la fecha de ingreso y cerrar casos'],['aprobarCot','PDI: aprobar cotizaciones, poner la fecha de ingreso y cerrar casos']];
  function lgNormUser(u){ return String(u||'').toLowerCase().trim().replace(/\s+/g,'.').replace(/[^a-z0-9._-]/g,'').slice(0,32); }
  function lgWaitDb(){ return new Promise(function(res){ var n = 0; (function t(){ if(db || n++>60) return res(db); setTimeout(t,150); })(); }); }
  function lgSalt(){ return Math.random().toString(36).slice(2)+Date.now().toString(36); }
  async function lgHash(pw, salt){
    try{ var h = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(salt+'|'+pw)); return Array.from(new Uint8Array(h)).map(function(x){ return ('0'+x.toString(16)).slice(-2); }).join(''); }
    catch(e){ return 'x'+btoa(unescape(encodeURIComponent(salt+'|'+pw))); }
  }
  function lgBuiltin(u){ return Object.keys(ROLE_CREDENTIALS).filter(function(k){ return !ROLE_CREDENTIALS[k].dyn && ROLE_CREDENTIALS[k].user===u; })[0] || null; }
  function lgPermFromDoc(d){
    d = d || {};
    var tabs = (d.tabs||[]).filter(function(t){ return ALL_TABS.indexOf(t)>-1 && t!=='usuarios' && t!=='guia'; });
    var flags = {}; PERM_FLAGS.forEach(function(f){ if(d.flags && d.flags[f[0]]) flags[f[0]] = true; });
    if(d.marcasVer && d.marcasVer.length) flags.marcasVer = d.marcasVer.slice();
    if(d.marcasApart && d.marcasApart.length) flags.marcasApart = d.marcasApart.slice();
    if(flags.exec && tabs.indexOf('panorama')<0) tabs.unshift('panorama');
    if(!tabs.length) flags.marcasVer = ['__NINGUNA__'];   // sin permisos: no ve ningún vehículo
    var p = permDe(tabs, flags); p.tabs.unshift('guia'); return p;
  }
  function lgRegister(user, d){
    var key = 'u_'+user;
    ROLE_CREDENTIALS[key] = {label:d.nombre||user, user:user, password:null, dyn:true};
    ROLE_PERMS[key] = lgPermFromDoc(d);
    return key;
  }
  async function lgApplyOverride(role){
    if(role==='jefe_operaciones' || !db) return;
    try{ var sn = await db.collection('permisos_roles').doc(role).get(); if(sn && sn.exists){ ROLE_PERMS[role] = lgPermFromDoc(sn.data()); } }catch(e){}
  }
  function lgShow(step){
    ['lgStep1','lgStep2','lgStep3'].forEach(function(id){ document.getElementById(id).hidden = (id!=='lgStep'+step); });
    document.getElementById('loginSub').textContent = step===1 ? 'Escribe tu usuario para continuar' : (step===2 ? 'Ahora escribe tu contraseña' : 'Crea tu usuario');
    loginError.classList.remove('show'); document.getElementById('lgErr1').classList.remove('show'); document.getElementById('lgErr3').classList.remove('show');
    var f = {1:'lgUser', 2:'loginPassword', 3:'lgcNombre'}[step]; setTimeout(function(){ try{ document.getElementById(f).focus(); }catch(e){} }, 30);
  }
  function lgErr(id, msg){ var e = document.getElementById(id); e.textContent = msg; e.classList.add('show'); }
  async function lgNext(){
    var u = lgNormUser(document.getElementById('lgUser').value);
    document.getElementById('lgErr1').classList.remove('show');
    if(!u){ lgErr('lgErr1','Escribe tu usuario.'); return; }
    var bt = document.getElementById('lgNext'); bt.disabled = true;
    try{
      var role = lgBuiltin(u);
      if(role){ pendingRole = role; pendingUser = u; pendingDoc = null; document.getElementById('lgName').textContent = ROLE_CREDENTIALS[role].label; }
      else {
        await lgWaitDb();
        if(!db){ lgErr('lgErr1','No hay conexión con la base de datos. Intenta de nuevo en un momento.'); return; }
        var sn = await db.collection('usuarios').doc(u).get();
        if(!sn || !sn.exists){ lgErr('lgErr1','Ese usuario no existe. Si eres nuevo, pulsa «Crear usuario».'); return; }
        var d = sn.data();
        if(d.activo===false){ lgErr('lgErr1','Este usuario está desactivado. Pide al Jefe de Operaciones que lo active.'); return; }
        pendingRole = null; pendingUser = u; pendingDoc = d; document.getElementById('lgName').textContent = d.nombre||u;
      }
      document.getElementById('lgUserShow').textContent = u; loginPassword.value = ''; lgShow(2);
    }catch(e){ lgErr('lgErr1','No pude validar el usuario. Intenta de nuevo.'); }
    finally{ bt.disabled = false; }
  }
  async function attemptLogin(){
    if(!pendingUser) return;
    var pw = loginPassword.value, ok = false, key = pendingRole;
    if(pendingRole){ ok = (pw === ROLE_CREDENTIALS[pendingRole].password); if(ok) await lgApplyOverride(pendingRole); }
    else if(pendingDoc){ ok = (await lgHash(pw, pendingDoc.salt||'')) === pendingDoc.hash; if(ok) key = lgRegister(pendingUser, pendingDoc); }
    if(!ok){ loginError.textContent = 'Contraseña incorrecta.'; loginError.classList.add('show'); return; }
    try{ localStorage.setItem('pdi_session_role', key); }catch(e){}
    if(pendingDoc && pendingDoc.nombre) setOperatorName(pendingDoc.nombre);
    enterAs(key);
  }
  document.getElementById('lgNext').addEventListener('click', lgNext);
  document.getElementById('lgUser').addEventListener('keydown', function(e){ if(e.key==='Enter') lgNext(); });
  document.getElementById('loginSubmit').addEventListener('click', attemptLogin);
