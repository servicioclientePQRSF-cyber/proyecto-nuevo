  function canonMaker(values){
    var cnt = {};
    values.forEach(function(v){ v = cStr(v); if(v && v!=='0'){ cnt[v]=(cnt[v]||0)+1; } });
    var best = {};
    Object.keys(cnt).forEach(function(v){
      var k = normH(v); var score = (/^[A-ZÁÉÍÓÚÑ]/.test(v)?1:0)*1e6 + cnt[v];
      if(!best[k] || score>best[k].score) best[k] = {score:score, v:v};
    });
    var alias = {playadeventasunicentro:'Playa Ventas Unicentro', ipiales:'Vitrina Ipiales', colision:'Colisión', colisionnovedad:'Colisión Novedad', ipialesentrega:'Vitrina Ipiales Entrega'};
    return function(raw){
      var v = cStr(raw); if(!v || v==='0') return '';
      var k = normH(v); if(alias[k]) return alias[k];
      return best[k] ? best[k].v : v;
    };
  }
  function estadoDeUbicacion(u){
    var k = normH(u); if(!k) return 'sin_ubicacion';
    if(k==='transportadora' || k==='transito') return 'transito';
    if(k==='sintransportadora' || k==='portransportar') return 'por_transportar';
    if(k==='sinliberar') return 'sin_liberar';
    if(k.indexOf('vitrina')===0) return 'vitrina';
    if(k.indexOf('colision')===0 || k.indexOf('carroceria')===0 || k.indexOf('taller')===0 || k.indexOf('accesorios')>-1 || k.indexOf('modecar')>-1) return 'taller';
    if(['postobon','briceno','pandiaco','sion','portilla'].some(function(b){ return k===b || k.indexOf(b)===0; })) return 'bodega';
    return 'otra';
  }
