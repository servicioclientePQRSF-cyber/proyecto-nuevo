        mCnt[v] = (mCnt[v]||0)+1;
        if(mCM>=0 && cur2.desc && cStr(r[mCM])) codeDict[normH(r[mCM])] = cur2.desc;
        if(mats[v]){ var o = mats[v]; ['placa','fplaca','fent','desc'].forEach(function(k){ if(!cur2[k]) cur2[k] = o[k]; }); }
        mats[v] = cur2;
      });
      Object.keys(mCnt).forEach(function(v){ if(mCnt[v]>1) res.unificados.push({vin:v, hoja:mName, filas:mCnt[v], detalle:'Aparecía '+mCnt[v]+' veces en Matrículas: se unificó en un solo registro (placa y fechas completadas entre filas).'}); });
      res.hojas.push({n:mName, ok:true, filas:Object.keys(mats).length});
