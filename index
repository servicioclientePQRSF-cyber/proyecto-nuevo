    vehiclesArr().filter(function(v){ return !esSalida(v); }).filter(function(v){ return mode==='si' ? isMat(v) : (mode==='no' ? !isMat(v) : true); }).forEach(function(v){
      var k = agMarcaOf(v), b = m[k] || (m[k] = {marca:k,total:0,mat:0,cons:0,sedes:0,origen:0,otros:0,a:0,b:0,c:0,sf:0});
      [b,tot].forEach(function(x){
        x.total++; if(isMat(v)) x.mat++; if(consEst(v)==='consignacion') x.cons++;
        if(GRUPO_SEDES.indexOf(v.estado)>-1) x.sedes++; else if(GRUPO_ORIGEN.indexOf(v.estado)>-1) x.origen++; else x.otros++;
        var d = agDias(v,'comb'); if(!d) x.sf++; else if(d.n<=mid) x.a++; else if(d.n<=u) x.b++; else x.c++;
      });
    });
    var arr = Object.keys(m).map(function(k){ return m[k]; }).sort(function(a,b){ return b.total-a.total || a.marca.localeCompare(b.marca,'es'); });
    var lm = {};
    vehiclesArr().filter(function(v){ return !esSalida(v); }).filter(function(v){ return mode==='si' ? isMat(v) : (mode==='no' ? !isMat(v) : true); }).forEach(function(v){
      var k = v.locacion || 'Pendiente definir ubicación'; lm[k] = (lm[k]||0)+1;
