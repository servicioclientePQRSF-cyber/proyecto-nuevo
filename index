    var codeDict = {}, mats = {}, mName = sheetNamed('matricula'), gM = gridOf(mName), hM = headerOf(gM, [['bastidor','vin'],'placa']);
    if(hM){
      var mV = pick(hM.map,['bastidor','vin']), mP = pick(hM.map,['placa']), mFP = pick(hM.map,['fplaca']), mFE = pick(hM.map,['fecent']), mDM = pick(hM.map,['desmodelo']), mCM = pick(hM.map,['codmodelo']);
