    }).join('');
  }
  async function asDelChat(id){
    var c = ASH.list.filter(function(x){ return x.id===id; })[0]; if(!c) return;
    if(!window.confirm('¿Eliminar esta conversación del historial?\n«'+(c.titulo||'Conversación')+'»\nNo se puede recuperar.')) return;
