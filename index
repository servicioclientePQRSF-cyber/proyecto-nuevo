  async function flUpload(key, file, max){
    max = max || 5*1024*1024;
    if(file.size > max) throw new Error('«'+file.name+'» pesa más de '+Math.round(max/1048576)+' MB. Comprímelo o súbelo más corto.');
    var isImg = /^image\//.test(file.type), data;
    if(isImg) data = await compressImage(file, 1600, 0.72);
    else data = await new Promise(function(res, rej){ var r = new FileReader(); r.onload = function(){ res(r.result); }; r.onerror = rej; r.readAsDataURL(file); });
    var aid = key+'_'+Date.now().toString(36), CH = 600000, n = Math.ceil(data.length/CH);
    for(var i=0;i<n;i++) await db.collection('casos_adjuntos').doc(aid+'_'+i).set({aid:aid, i:i, n:n, key:key, data:data.slice(i*CH,(i+1)*CH), fecha:new Date().toISOString()});
    return {id:aid, n:n, nombre:file.name, tipo:(isImg? 'image/jpeg' : (file.type||'application/octet-stream')), size:file.size};
  }
  function flDataToBlob(data, tp){
    var i = data.indexOf(','), bin = atob(data.slice(i+1)), arr = new Uint8Array(bin.length);
    for(var k=0;k<bin.length;k++) arr[k] = bin.charCodeAt(k);
    return new Blob([arr], {type:tp||'application/octet-stream'});
  }
  async function flMediaUp(key, btn){
    if(!flCanPdi()) return false;
    var fi = document.getElementById('fl_media'), files = fi && fi.files ? Array.prototype.slice.call(fi.files).slice(0,6) : [];
    if(!files.length){ toast('Elige las fotos o videos.'); return false; }
    var f = JSON.parse(JSON.stringify(flGet(key))), w = flWho(), now = new Date().toISOString(), inf = flInfo(key), nf = 0, nv = 0, old = btn.textContent;
    f.media = f.media || [];
    if(f.media.length + files.length > 30){ toast('Cada caso admite hasta 30 fotos y videos.'); return false; }
    btn.disabled = true;
    for(var i=0;i<files.length;i++){
      var file = files[i], isV = /^video\//.test(file.type), isI = /^image\//.test(file.type);
      btn.textContent = 'Subiendo '+(i+1)+' de '+files.length+'…';
      if(!isV && !isI){ toast('«'+file.name+'» no es foto ni video.'); continue; }
      try{
        var thumb = isI ? await compressImage(file, 220, 0.5) : '';
        var m = await flUpload(key, file, isV ? 12*1024*1024 : 8*1024*1024);
        f.media.push({id:m.id, n:m.n, nombre:m.nombre, tipo:m.tipo, size:m.size, thumb:thumb, por:w.por, rol:w.rol, ts:now});
        if(isV) nv++; else nf++;
      }catch(err){ toast(err && err.message || 'No se pudo subir «'+file.name+'».'); }
    }
    btn.disabled = false; btn.textContent = old;
    if(!nf && !nv) return false;
    f.meta = {tipo:inf.tipo, label:inf.label, veh:inf.veh, nov:inf.nov, marca:inf.marca};
    f.ev = f.ev || [];
    var txt = 'Subió '+(nf? nf+' foto'+(nf>1?'s':'') : '')+(nf&&nv? ' y ' : '')+(nv? nv+' video'+(nv>1?'s':'') : '');
    f.ev.push({f:now, u:w.por, r:w.rol, t:'media', x:txt});
    return await cxPut(key, {flujo:f}, {notif:[{para:flOther(), tipo:'Fotos y videos nuevos', texto:w.por+' '+txt.charAt(0).toLowerCase()+txt.slice(1)+' al caso ('+(inf.veh||inf.label)+').'}]});
  }
