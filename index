  async function lgCrearUsuario(nombre, user, pw, pw2, errId, creador, base){
    nombre = String(nombre||'').trim().replace(/\s+/g,' ');
    var u = lgNormUser(user);
    if(nombre.length<3) return lgErr(errId,'Escribe el nombre completo.');
    if(u.length<3) return lgErr(errId,'El usuario debe tener al menos 3 caracteres (letras, números, punto o guion).');
    if(pw.length<6) return lgErr(errId,'La contraseña debe tener al menos 6 caracteres.');
    if(pw!==pw2) return lgErr(errId,'Las contraseñas no coinciden.');
    if(lgBuiltin(u)) return lgErr(errId,'Ese usuario ya existe. Elige otro.');
    await lgWaitDb(); if(!db) return lgErr(errId,'No hay conexión con la base de datos. Intenta de nuevo.');
    try{
      var sn = await db.collection('usuarios').doc(u).get();
      if(sn && sn.exists) return lgErr(errId,'Ese usuario ya existe. Elige otro.');
      var salt = lgSalt(), hash = await lgHash(pw, salt), now = new Date().toISOString();
      var d = Object.assign({usuario:u, nombre:nombre, salt:salt, hash:hash, tabs:[], flags:{}, marcasVer:[], marcasApart:[], activo:true, creado:now, creado_por:creador}, base||{});
      await db.collection('usuarios').doc(u).set(d);
      return u;
    }catch(e){ return lgErr(errId,'No se pudo crear el usuario: '+(e && e.message || 'error')); }
  }
