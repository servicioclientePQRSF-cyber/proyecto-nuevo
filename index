        else res.noenc.push({vin:vin, line:it.line});
        return;
      }
      var out = K.calc(v, x, U.opts, U);
      var entry = {vin:vin, vid:v.vid, line:it.line, ref:v.referencia||'', upd:out.upd||{}, cambios:out.cambios||[], motivo:out.skip||''};
      if(out.skip) res.omitidos.push(entry);
      else if(entry.cambios.length) res.cambios.push(entry);
      else res.iguales.push(entry);
    });
  }

