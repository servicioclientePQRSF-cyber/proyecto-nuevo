  // --- asignación masiva desde Excel / CSV ---
  var upRows = [];
  function normH(s){ return String(s==null?'':s).normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase().replace(/[^a-z0-9]/g,''); }
  var ALIAS = {
    vin:['vin','nvin','numerovin','chasis','vinchasis','serie'],
    estado:['estado','soporte','estadoasignacion','estadocomercial','situacion'],
    marca:['marca'],
    gerente:['gerente','gerentedemarca','gerentemarca','gerentecomercial','asignadoa','asignado','responsable'],
    orden:['ordendepedido','orden','pedido','nordendepedido','numerodeorden','ordenpedido','numeroordenpedido','op'],
    placa:['placa'],
    cliente:['cliente','nombrecliente']
  };
  function parseSheet(grid){
    var hi = -1, i, j;
    for(i=0;i<Math.min(grid.length,15)&&hi<0;i++){
      for(j=0;j<grid[i].length;j++){ if(ALIAS.vin.indexOf(normH(grid[i][j]))>-1){ hi=i; break; } }
    }
    if(hi<0) return {error:'No encontré una columna «VIN» en las primeras filas del archivo.'};
    var col = {};
    grid[hi].forEach(function(h,idx){
      var n = normH(h);
      Object.keys(ALIAS).forEach(function(k){ if(col[k]==null && ALIAS[k].indexOf(n)>-1) col[k]=idx; });
    });
    var out = [];
    for(i=hi+1;i<grid.length;i++){
      var r = grid[i]; var get = function(k){ return col[k]==null ? '' : String(r[col[k]]==null?'':r[col[k]]).trim(); };
      var raw = get('vin'); if(!raw && !get('estado') && !get('gerente')) continue;
      out.push({line:i+1, vinRaw:raw, estado:get('estado'), marca:get('marca'), gerente:get('gerente'), orden:get('orden'), placa:get('placa'), cliente:get('cliente')});
    }
    return {rows:out, cols:Object.keys(col)};
  }
  function evalUploadRow(row, defGerente){
    var res = {line:row.line, vin:sanitizeVin(row.vinRaw), row:row};
    if(!res.vin){ res.error='Fila sin VIN.'; return res; }
    var v = findByVin(res.vin);
    if(!v){ res.error='VIN no está en el inventario.'; return res; }
    res.v = v;
    var n = normH(row.estado);
    var a = {fact:n.indexOf('factur')>-1, mat:n.indexOf('matricul')>-1, ord:n.indexOf('orden')>-1||n.indexOf('pedido')>-1,
             orden:row.orden, placa:sanitizePlaca(row.placa), marca:row.marca, gerente:row.gerente||defGerente, cliente:row.cliente, fuente:'Excel'};
    if(row.orden) a.ord = true;
    if(row.estado && !a.fact && !a.mat && !a.ord){ res.error='Estado no reconocido: «'+row.estado+'». Usa Facturado, Matriculado o Con orden de pedido.'; return res; }
    var r = evaluateAssign(v, a);
    if(r.error){ res.error=r.error; return res; }
    res.update = r.update;
    return res;
  }
