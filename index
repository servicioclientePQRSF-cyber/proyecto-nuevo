  function prResolverVin(txt){
    var s = sanitizeVin(txt); if(!s) return {err:'Escribe el VIN o sus últimos dígitos.'};
    var f = findByVin(s); if(f) return {vin:f.vin||f.vid, v:f};
    if(s.length>=5){
      var m = vehiclesArr().filter(function(v){ var k = sanitizeVin(v.vin||v.vid); return k.length>s.length && k.slice(-s.length)===s; });
      if(m.length===1) return {vin:m[0].vin||m[0].vid, v:m[0]};
      if(m.length>1) return {err:'Hay '+m.length+' vehículos que terminan en «'+s+'». Escribe más dígitos.'};
    }
    if(s.length>=11) return {vin:s, v:null};
    return {err:'No encontré ese final en el inventario. Escribe el VIN completo.'};
  }
