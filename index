  function runImpCompare(){
    if(cru.on){ runCruce(); return; }
    if(!imp.grid || imp.hi<0) return;
    if(imp.map.vin==null){
      document.getElementById('imp_prevPanel').style.display='none'; return;
    }
    document.getElementById('imp_prevPanel').style.display='';
    var o = {estado:document.getElementById('io_estado').checked, sede:document.getElementById('io_sede').checked,
             mat:document.getElementById('io_mat').checked, fill:document.getElementById('io_fill').checked, nuevo:document.getElementById('io_new').checked};
    var rows = imp.grid.slice(imp.hi+1);
    var res = {cambios:[], nuevos:[], iguales:[], ausentes:[], errores:[], repetidos:0};
    var byVin = {}, order = [];
    rows.forEach(function(r, idx){
      if(r.every(function(c){ return String(c).trim()===''; })) return;
      var raw = impCell(r,'vin'); var vin = sanitizeVin(raw); var line = imp.hi+2+idx;
      if(!vin || vin.length<6){ res.errores.push({line:line, vin:raw||'—', msg: raw? 'VIN demasiado corto ('+sanitizeVin(raw).length+' caracteres).' : 'Fila sin VIN.'}); return; }
      if(byVin[vin]){ res.repetidos++; } else order.push(vin);
      byVin[vin] = {r:r, line:line};
    });
    var seenIds = {};
    order.forEach(function(vin){
      var it = byVin[vin]; var r = it.r;
      var estadoKey = normH(impCell(r,'estado')), sedeKey = normH(impCell(r,'sede'));
      var nuevoEstado = (imp.map.estado!=null && estadoKey && imp.vals.estado[estadoKey]) ? imp.vals.estado[estadoKey].to : '';
      var nuevaSede = (imp.map.sede!=null && sedeKey && imp.vals.sede[sedeKey]) ? imp.vals.sede[sedeKey].to : '';
      var marca = impCell(r,'marca'), ref = impCell(r,'referencia');
      var referencia = marca && ref && normH(ref).indexOf(normH(marca))===0 ? ref : [marca,ref].filter(Boolean).join(' ');
      var data = {referencia:referencia, color:impCell(r,'color'), placa:sanitizePlaca(impCell(r,'placa')), bodega:impCell(r,'bodega'),
                  matricula_estado:guessMatricula(impCell(r,'matricula')), orden_pedido:impCell(r,'orden')};
      var v = findByVin(vin);
      if(v) seenIds[v.vid]=true;
      if(!v){
        if(!o.nuevo){ return; }
        var nuevo = {vin:vin, referencia:data.referencia, color:data.color, placa:data.placa, estado:nuevoEstado, locacion:nuevaSede,
                     bodega:data.bodega, matricula_estado:data.matricula_estado||'', orden_pedido:data.orden_pedido};
        res.nuevos.push({vin:vin, line:it.line, data:nuevo});
        return;
      }
      var upd = {}, cambios = [];
      if(o.estado && nuevoEstado && v.estado!==nuevoEstado){ upd.estado=nuevoEstado; cambios.push('Estado: '+((ESTADOS[v.estado]||{}).label||'Sin información')+' → '+ESTADOS[nuevoEstado].label); }
      if(o.sede){
        if(nuevaSede && v.locacion!==nuevaSede){ upd.locacion=nuevaSede; cambios.push('Sede: '+(v.locacion||'Sin información')+' → '+nuevaSede); }
        var estadoFinal = upd.estado || v.estado;
        if(data.bodega && estadoFinal==='bodega' && (v.bodega||'')!==data.bodega){ upd.bodega=data.bodega; cambios.push('Bodega: '+(v.bodega||'—')+' → '+data.bodega); }
      }
      if(o.mat){
        if(data.placa && (v.placa||'')!==data.placa){ upd.placa=data.placa; cambios.push('Placa: '+(v.placa||'—')+' → '+data.placa); }
        if(data.matricula_estado && (v.matricula_estado||'')!==data.matricula_estado){ upd.matricula_estado=data.matricula_estado; cambios.push('Matrícula: '+(v.matricula_estado||'Sin información')+' → '+data.matricula_estado); }
        if(data.orden_pedido && (v.orden_pedido||'')!==data.orden_pedido){ upd.orden_pedido=data.orden_pedido; cambios.push('Orden de pedido: '+(v.orden_pedido||'—')+' → '+data.orden_pedido); }
      }
      if(o.fill){
        if(data.referencia && !v.referencia){ upd.referencia=data.referencia; cambios.push('Referencia: '+data.referencia); }
        if(data.color && !v.color){ upd.color=data.color; cambios.push('Color: '+data.color); }
      }
      var entry = {vin:vin, vid:v.vid, line:it.line, ref:v.referencia||data.referencia||'', upd:upd, cambios:cambios};
      if(cambios.length) res.cambios.push(entry); else res.iguales.push(entry);
    });
    vehiclesArr().forEach(function(v){ if(!seenIds[v.vid] && !esSalida(v)) res.ausentes.push({vin:v.vin||'', vid:v.vid, ref:v.referencia||'', estado:v.estado, placa:v.placa||''}); });
